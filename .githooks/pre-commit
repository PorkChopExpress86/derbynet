#! /bin/bash
#
# Before a commit: refuses one while tools/mutate.py holds a lock in this
# worktree's git directory, and runs ruff on the staged Python under server/.
#
# A mutate.py run rewrites its file in place for each mutant, and restores
# the working tree, not the index: the #463 retro staged `if True else []`
# this way, and #470's implementer edited a file mid-run and left a mutant
# in it (#470 retro). A SIGKILL leaves the lock behind; the refusal names it.
#
# #400's 53dffcf2 joined two docstring lines into one of 93 columns, and the
# pre-push hook's ruff found it a full push wait later (#400 retro). Ruff
# reads the working tree's copy of each staged file, so a partial `git add
# -p` is checked as the whole file. With no server/.venv (uv sync builds it)
# the ruff half is skipped, and says so. `git commit --no-verify` skips it.

set -e -o pipefail

ROOT="$(git rev-parse --show-toplevel)"
locks=("$(git rev-parse --absolute-git-dir)"/mutate-*.lock)
if [ -e "${locks[0]}" ]; then
  echo "pre-commit: tools/mutate.py holds these locks, so a file may hold a" \
       "mutant; commit once every run has ended. If a run is gone, read" \
       "git diff -- <its file>, then remove its lock:" >&2
  for lock in "${locks[@]}"; do
    pid=$(cat "$lock" 2>/dev/null || true)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      echo "  $lock (pid $pid, running)" >&2
    else
      echo "  $lock (pid ${pid:-?}, gone)" >&2
    fi
  done
  exit 1
fi

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR -- 'server/*.py' |
                      sed 's,^server/,,')
[ ${#staged[@]} -gt 0 ] || exit 0
RUFF="${DERBYNET_RUFF:-$ROOT/server/.venv/bin/ruff}"
if [ ! -x "$RUFF" ]; then
  echo "pre-commit: no $RUFF, so ruff is left to the pre-push hook" >&2
  exit 0
fi
cd "$ROOT/server"
"$RUFF" check --quiet --force-exclude -- "${staged[@]}"
"$RUFF" format --check --quiet --force-exclude -- "${staged[@]}"
