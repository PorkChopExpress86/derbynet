#! /bin/bash
#
# Before a commit: refuses one while tools/mutate.py holds a lock in this
# worktree's git directory, or while the pre-push hook checks the branch,
# and runs ruff on the staged Python under server/.
#
# A mutate.py run rewrites its file in place for each mutant, and restores
# the working tree, not the index: the #463 retro staged `if True else []`
# this way, and #470's implementer edited a file mid-run and left a mutant
# in it (#470 retro). A SIGKILL leaves the lock behind, and its file may
# still hold the mutant, so a lock whose pid is gone still refuses.
#
# #400's 53dffcf2 joined two docstring lines into one of 93 columns, and the
# pre-push hook's ruff found it a full push wait later (#400 retro). Ruff
# reads the working tree's copy of each staged file, so a partial `git add
# -p` is checked as the whole file. With no server/.venv (uv sync builds it)
# the ruff half is skipped, and says so. `git commit --no-verify` skips it.

set -e -o pipefail

ROOT="$(git rev-parse --show-toplevel)"
locks=("$(git rev-parse --absolute-git-dir)"/mutate-*.lock)
if [ -e "${locks[0]}" ]; then
  echo "pre-commit: tools/mutate.py holds these locks, so a file may hold a" \
       "mutant; commit once every run has ended. A lock names its run's pid," \
       "not its file: if the pid is gone, git diff shows the mutant it left;" \
       "restore that file, then remove the lock:" >&2
  for lock in "${locks[@]}"; do
    pid=$(cat "$lock" 2>/dev/null || true)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      echo "  $lock (pid $pid, running)" >&2
    else
      echo "  $lock (pid ${pid:-?}, gone)" >&2
    fi
  done
  exit 1
fi

# A commit on a ref the pre-push hook is checking fails that push when its
# checks end, since git may send a commit they never read: #500's two
# commits during the checks of 106ef5b6 cost the 637 s push (#500 retro).
# The hook's lock names its pid and holds one ref per line; a lock whose pid
# is gone, left by a SIGKILL, refuses nothing. `git rebase` runs no
# pre-commit, so the hook's own check of its refs at exit stays.
branch=$(git symbolic-ref -q HEAD || true)
common="$(cd "$(git rev-parse --git-common-dir)" && pwd)"
for lock in "$common"/pre-push-*.lock; do
  [ -e "$lock" ] || continue
  pid=${lock##*/pre-push-}
  pid=${pid%.lock}
  kill -0 "$pid" 2>/dev/null || continue
  if [ -n "$branch" ] && grep -qxF -e "$branch" "$lock"; then
    echo "pre-commit: pre-push $pid is checking $branch, and a commit on it now" \
         "fails that push once its checks end. Commit once the push ends," \
         "or stop the push first (#500 retro)." >&2
    exit 1
  fi
done

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR -- 'server/*.py' |
                      sed 's,^server/,,')
[ ${#staged[@]} -gt 0 ] || exit 0
RUFF="${DERBYNET_RUFF:-$ROOT/server/.venv/bin/ruff}"
if [ ! -x "$RUFF" ]; then
  echo "pre-commit: no $RUFF, so ruff is left to the pre-push hook" >&2
  exit 0
fi
cd "$ROOT/server"
"$RUFF" check --quiet --force-exclude -- "${staged[@]}"
"$RUFF" format --check --quiet --force-exclude -- "${staged[@]}"
