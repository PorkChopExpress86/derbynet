#! /bin/bash
#
# Runs the quick checks of the `lint` job in .github/workflows/server.yml
# before a push that changes server/, testing/ or website/inc/generators/, so a
# red lint shows up in seconds instead of after CI.  It also checks that the
# HTTP golden fixtures were captured from the testing/ scripts being pushed
# (server/tools/golden_inputs.py), which the golden-fixtures workflow finds
# only after a 25-minute capture, and the paths the ADRs cite, which
# plan-checks.yml checks (#70 retro: a path without its server/ prefix failed
# CI twice), and the tests that read only the source
# (server/tools/source-checks.sh, #48 retro).  It runs plan/tests on every
# push, as plan-checks.yml does: #222 changed the parity gate a plan test read,
# and only CI found it (#218 retro).  It refuses a push typed in the same
# command after a pytest run or a read of its output (#282 retro).  Turn it on once per clone:
#
#   git config core.hooksPath .githooks
#
# It checks the working tree, which is what was just committed when the tree
# is clean.  `git push --no-verify` skips it.

set -e -o pipefail

ROOT="$(git rev-parse --show-toplevel)"
ZERO=0000000000000000000000000000000000000000

# A push in the same shell command as a pytest run, or as a read of a run's
# output, goes out before anyone reads that result: #238 chained it after
# the full suite, and #282 after `cat .../tasks/<id>.output` showed a red
# Postgres run (plan/AGENT-BRIEF.md, Evidence).  It reads the `-c` script of each shell
# above the hook, through /proc, so it checks nothing off Linux.
# Quoted words, heredoc bodies and comments are left out, so a commit
# message that names pytest does not count.
python3 -I - "$PPID" <<'EOF' || exit 1
import re, sys


def code_of(script):
    # The Bash tool runs a command as `... && eval '<command>' && ...`.
    wrapped = re.search(r"\beval '((?:[^']|'\"'\"')*)'", script)
    if wrapped:
        script = wrapped.group(1).replace("'\"'\"'", "'")
    script = re.sub(
        r"<<-?\s*(['\"]?)(\w+)\1([^\n]*)\n.*?\n\s*\2(?=\n|$)", r"\3", script, flags=re.S
    )
    script = re.sub(r"'[^']*'|\"(?:\\.|[^\"\\])*\"", "''", script)
    return re.sub(r"(^|\s)#[^\n]*", r"\1", script)


pid = int(sys.argv[1])
while pid > 1:
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            argv = [a.decode(errors="replace") for a in f.read().split(b"\0")]
        with open(f"/proc/{pid}/stat") as f:
            ppid = int(f.read().rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        break
    flags = [i for i, a in enumerate(argv[1:-1], 1) if re.fullmatch(r"-[a-z]*c[a-z]*", a)]
    script = code_of(argv[flags[0] + 1]) if flags else ""
    # `git -C dir push`, `git -c k=v push` and the like count too.
    push = re.search(r"\bgit\b[^;&|\n]*?\spush\b", script)
    # pytest itself (tools/pytest-postgres.sh too, and pytest.log), a
    # background task's output file, or a junit file.
    run = r"\bpytest\b|/tasks/[\w-]+\.output\b|\bjunit\.xml\b"
    if push and re.search(run, script[: push.start()]):
        sys.exit(
            "pre-push: this push runs in the same command as a pytest run, or "
            "a read of a run's output, before it. Read that run's exit code, "
            "then push in a command of its own (plan/AGENT-BRIEF.md, Evidence)."
        )
    pid = ppid
EOF

# Under a second, and plan/bin reads server/ and .github/, so on every push.
echo "pre-push: plan/tests" >&2
if ! out="$(python3 -I -m unittest discover -s "$ROOT/plan/tests" 2>&1 </dev/null)"; then
  printf '%s\n' "$out" >&2
  exit 1
fi

# Git sends one "<local ref> <local sha> <remote ref> <remote sha>" line per
# ref it pushes.  A new branch has no remote sha; compare it with master.
changed=
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue  # a deleted ref
  if [ "$remote_sha" = "$ZERO" ]; then
    base="$(git merge-base "$local_sha" origin/master 2>/dev/null \
              || git merge-base "$local_sha" master 2>/dev/null || true)"
  else
    base="$remote_sha"
  fi
  # The whole list first: under pipefail, grep -q's early exit can fail the
  # pipe (server/tests/test_pipefail_pipes.py).  image.yml runs checks.sh,
  # which server/tests/test_docker_checks.py reads (#58 retro).
  if [ -z "$base" ] \
       || grep -qE '^(server/|testing/|website/inc/generators/|\.github/workflows/image\.yml$)' \
            <<<"$(git diff --name-only "$base" "$local_sha")"; then
    changed=1
  fi
done
[ -n "$changed" ] || exit 0

echo "pre-push: server/docs/adr/check-paths.sh" >&2
# Print only the failures and the count, not one line per cited path.
bash "$ROOT/server/docs/adr/check-paths.sh" | grep -v -e '^ok ' -e '^allowed '

cd "$ROOT/server"
# makemigrations reads DATABASE_URL; the check needs no particular database.
run() { echo "pre-push: $*" >&2; env -u DATABASE_URL uv run --locked "$@"; }
run ruff check
run ruff format --check
run python tools/convert_generators.py --check
run python tools/reschedule_deviations.py --check
run python manage.py makemigrations --check --dry-run
run python tools/golden_inputs.py --check
echo "pre-push: tools/source-checks.sh" >&2
tools/source-checks.sh
