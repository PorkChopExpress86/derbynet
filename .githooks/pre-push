#! /bin/bash
#
# Runs the quick checks of the `lint` job in .github/workflows/server.yml
# before a push that changes server/, testing/, website/inc/generators/,
# .github/workflows/image.yml or plan/, so a red lint shows up before the
# push instead of after CI.  It also checks that the
# HTTP golden fixtures were captured from the testing/ scripts being pushed
# (server/tools/golden_inputs.py), which the golden-fixtures workflow finds
# only after a 25-minute capture, and the paths the ADRs cite, which
# plan-checks.yml checks (#70 retro: a path without its server/ prefix failed
# CI twice), and the tests that read only the source
# (server/tools/source-checks.sh, #48 retro).  It runs plan/tests on every
# push, as plan-checks.yml does: #222 changed the parity gate a plan test read,
# and only CI found it (#218 retro).  They run once: source-checks.sh runs
# them on a push it checks, and the hook runs them itself on any other push
# (#311 retro).  It runs check-paths.sh --docs, as plan-checks.yml does, on
# every push of a branch, about 3 s: #345's backticked `manage.py` passed the
# hook and failed the hand-off, and a push that moves a path a guide cites
# changes no guide (#345 retro, PR #364's review).  It refuses a push typed in the same
# command after a pytest run or a read of its output (#282 retro).  It refuses
# a closing keyword in the message of a commit it pushes, as pr-evidence does
# in a PR body, before git sends the commit (plan/bin/commit-closes, #439).
# Turn it on once per clone:
#
#   git config core.hooksPath .githooks
#
# It checks a detached copy of the pushed commit, so the working tree may
# change while it runs (#470 retro), or, when the pushed refs name two
# commits, the working tree, and fails when that changes (#373 retro).
# `git push --no-verify` skips it.

set -e -o pipefail

ROOT="$(git rev-parse --show-toplevel)"
# Git sets GIT_DIR for a hook. Under it, a test's `git init` in a scratch
# folder reinitializes this repository: pushed from a worktree, it set
# core.bare=true in the main clone's .git/config and stopped every checkout
# (#351 and #369 retro). The hook and its checks run in the working tree,
# where git finds the repository without it, so it drops every variable that
# names a repository (`git rev-parse --local-env-vars`).
unset $(git rev-parse --local-env-vars)
ZERO=0000000000000000000000000000000000000000

# A push in the same shell command as a pytest run, or as a read of a run's
# output, goes out before anyone reads that result: #238 chained it after
# the full suite, and #282 after `cat .../tasks/<id>.output` showed a red
# Postgres run (plan/AGENT-BRIEF.md, Evidence).  It reads the `-c` script of each shell
# above the hook, through /proc, so it checks nothing off Linux.
# Quoted words, heredoc bodies and comments are left out, so a commit
# message that names pytest does not count.
python3 -I - "$PPID" <<'EOF' || exit 1
import re, sys


def code_of(script):
    # The Bash tool runs a command as `... && eval '<command>' && ...`.
    wrapped = re.search(r"\beval '((?:[^']|'\"'\"')*)'", script)
    if wrapped:
        script = wrapped.group(1).replace("'\"'\"'", "'")
    script = re.sub(
        r"<<-?\s*(['\"]?)(\w+)\1([^\n]*)\n.*?\n\s*\2(?=\n|$)", r"\3", script, flags=re.S
    )
    script = re.sub(r"'[^']*'|\"(?:\\.|[^\"\\])*\"", "''", script)
    return re.sub(r"(^|\s)#[^\n]*", r"\1", script)


pid = int(sys.argv[1])
while pid > 1:
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            argv = [a.decode(errors="replace") for a in f.read().split(b"\0")]
        with open(f"/proc/{pid}/stat") as f:
            ppid = int(f.read().rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        break
    flags = [i for i, a in enumerate(argv[1:-1], 1) if re.fullmatch(r"-[a-z]*c[a-z]*", a)]
    script = code_of(argv[flags[0] + 1]) if flags else ""
    # `git -C dir push`, `git -c k=v push` and the like count too.
    push = re.search(r"\bgit\b[^;&|\n]*?\spush\b", script)
    # pytest itself (tools/pytest-postgres.sh too, and pytest.log), a
    # background task's output file, or a junit file.
    run = r"\bpytest\b|/tasks/[\w-]+\.output\b|\bjunit\.xml\b"
    if push and re.search(run, script[: push.start()]):
        sys.exit(
            "pre-push: this push runs in the same command as a pytest run, or "
            "a read of a run's output, before it. Read that run's exit code, "
            "then push in a command of its own (plan/AGENT-BRIEF.md, Evidence)."
        )
    pid = ppid
EOF

# Git sends one "<local ref> <local sha> <remote ref> <remote sha>" line per
# ref it pushes.  A new branch has no remote sha; compare it with master.
changed=
pushed=
# Each pushed ref changes plan/owner-decisions.md and nothing else.
decisions=1
# Some pushed ref, or its base, holds plan/tests. The screenshots branch
# (D75) holds PNGs and no code, so the checks find none of their scripts in
# it and fail its push (session retro 2026-11-24); a branch that deletes
# plan/tests still runs them (PR #505's review). A base this clone lacks
# counts as code.
code=
pushes=()
locals=()
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue  # a deleted ref
  pushed=1
  pushes+=("$local_sha $remote_ref $remote_sha")  # a ref name holds no space
  locals+=("$local_sha $local_ref")
  if [ "$remote_sha" = "$ZERO" ]; then
    base="$(git merge-base "$local_sha" origin/master 2>/dev/null \
              || git merge-base "$local_sha" master 2>/dev/null || true)"
  else
    base="$remote_sha"
  fi
  if git cat-file -e "$local_sha:plan/tests" 2>/dev/null \
      || { [ -n "$base" ] && ! git cat-file -e "$base:" 2>/dev/null; } \
      || { [ -n "$base" ] && git cat-file -e "$base:plan/tests" 2>/dev/null; }; then
    code=1
  fi
  # The whole list first: under pipefail, grep -q's early exit can fail the
  # pipe (server/tests/test_pipefail_pipes.py).  image.yml runs checks.sh,
  # which server/tests/test_docker_checks.py reads (#58 retro).
  # With no base, the server checks run; a base this clone lacks lists
  # nothing, as the diff inside the test did before.
  # Source checks read plan/ too: owner-decisions.md
  # (legacy_api/tests/test_registry.py, tests/test_deviations.py), its
  # Python (tests/test_listing_order.py), every tracked .md and .py
  # (tests/test_docker_checks.py) and plan/bin's bash scripts
  # (tests/test_pipefail_pipes.py). #346's push ran none of them, and its
  # hand-off queued about 1.5 h for the run D112 said the push makes
  # (#346 retro; D129). plan-checks.yml runs them on a PR (D128).
  names=
  if [ -n "$base" ]; then
    names="$(git diff --name-only "$base" "$local_sha" || true)"
  fi
  [ "$names" = plan/owner-decisions.md ] || decisions=
  # The guides and the workflows that run their stages, which
  # tests/test_guide_commands.py reads (#414).
  checked='^(server/|testing/|website/inc/generators/|plan/|docs/[^/]+\.md$'
  checked+='|\.github/workflows/(image|server)\.yml$)'
  if [ -z "$base" ] || grep -qE "$checked" <<<"$names"; then
    changed=1
  fi
done
# A closing keyword in a commit message closes its issue when the commit
# reaches master, and the squash message lists each commit's message. It is
# refused here, before git sends the commit and before the slow checks, where
# pr-merge would run only once the commit is on GitHub; `pr-evidence --check`
# reads the PR body only (#439, #415 retro). It reads `git log`, about a second.
# DERBYNET_PUSH_CLOSES="64 65" names the issues the push closes on purpose,
# and a ref pushed as issue-<n>-<slug> may close its ticket, n, as the PR
# body may, and each commit it sends, merges left out, names #n (--ticket,
# #499 retro; --ticket-base, #504 review). Neither origin/master nor local master is read, unless the push
# is to master itself: a stale origin/master behind local master read
# master's own `fixes #64` and `Closes #316` again (#439 review). With no
# origin/master, every commit no remote-tracking branch has is read.
# The tool is the one beside this hook, not the pushed tree's: core.hooksPath
# names the main clone's .githooks, so a push from a branch cut before the
# tool existed runs this hook against a tree that lacks it. A missing tool
# fails the push.
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
closes_args=()
for issue in ${DERBYNET_PUSH_CLOSES:-}; do
  closes_args+=(--closes "$issue")
done
for push in ${pushes[@]+"${pushes[@]}"}; do
  read -r sha ref old <<<"$push"
  args=()
  if git rev-parse -q --verify origin/master >/dev/null; then
    args=(--base origin/master)
    if [ "$ref" != refs/heads/master ] \
        && git rev-parse -q --verify refs/heads/master >/dev/null; then
      args+=(--base refs/heads/master)
    fi
  fi
  if [[ $ref =~ ^refs/heads/issue-([1-9][0-9]*)- ]]; then
    args+=(--closes "${BASH_REMATCH[1]}" --ticket "${BASH_REMATCH[1]}")
    # Only the commits this push sends: one the remote ref already has can
    # be mended only by a force push (#504 review). Master's commits that a
    # merge or a rebase brings in are not the branch's own: the tool leaves
    # out what any remote-tracking branch has, origin/master among them, and
    # local master is a base when the closing check reads it as one, for a
    # stale origin/master (#504 review round 2).
    if git cat-file -e "$old^{commit}" 2>/dev/null; then
      args+=(--ticket-base "$old")
    fi
    if [[ " ${args[*]} " == *" --base refs/heads/master "* ]]; then
      args+=(--ticket-base refs/heads/master)
    fi
  fi
  echo "pre-push: plan/bin/commit-closes $sha ($ref)" >&2
  python3 -I "$HOOK_DIR/../plan/bin/commit-closes" ${args[@]+"${args[@]}"} \
    ${closes_args[@]+"${closes_args[@]}"} --head "$sha"
done
# The checks run in a detached copy of the pushed commit when every pushed
# ref names the same commit, so the working tree is free while they run,
# about 15 min: #400's implementer edited it during the hook, which then
# refused the push, about 25 min late, and #470's sat idle through six
# pushes (#470 retro). The copy is a worktree under ${XDG_CACHE_HOME:-~/.cache}
# named for the hook's pid; `uv run --locked` builds its server/.venv from
# uv's cache, as pr-merge's does. The checks run as a background job in a
# process group of their own, so the trap stops them before it removes the
# copy, and ignores a second signal while it does (AGENT-BRIEF, #333
# review). A SIGKILL runs no trap: the next push removes each copy whose
# hook is gone, with the processes still running in it. A commit made on a
# pushed ref during the checks fails the push: the #470 retro's first push
# checked a9d8d04e, and GitHub received 50650764, committed during the
# checks, which none had read. When the pushed refs name two commits, the
# checks read the working tree as before, and fail when it changes while
# they run: #373's implementer edited network_changed.py during the hook,
# and the run left rerun pytests behind. The head, the status, the tracked
# changes and the contents of the untracked files are compared at exit
# (#390 review).
mapfile -t shas < <(for push in ${pushes[@]+"${pushes[@]}"}; do echo "${push%% *}"; done |
                    sort -u)
if [ -n "$pushed" ] && [ -z "$code" ]; then
  echo "pre-push: no pushed ref holds plan/tests, nor did its base, so no check reads it" >&2
  exit 0
fi
COPY=
checks_pid=
# Seconds the trap waits for a check that ignores TERM before it kills it.
KILL_WAIT=${PRE_PUSH_KILL_WAIT:-10}
case "$KILL_WAIT" in
  '' | *[!0-9]* | 0?*) echo "pre-push: PRE_PUSH_KILL_WAIT takes a whole number of seconds, not '$KILL_WAIT'" >&2; exit 1 ;;
esac
# The refs this push checks, for .githooks/pre-commit, which refuses a
# commit on one of them while this hook runs: #500's implementer made two
# commits during the checks of 106ef5b6, and the hook refused the push 637 s
# in (#500 retro). The lock sits in the common git dir, so a commit from any
# worktree sees it, and a lock whose pid is gone refuses nothing. Each
# branch below writes it once its trap is set, so a signal can't leave it
# behind; a SIGKILL can, and the next push removes each lock whose pid is
# gone, before a new process takes that pid (PR #517's review).
LOCKS="$(cd "$(git rev-parse --git-common-dir)" && pwd)"
LOCK="$LOCKS/pre-push-$$.lock"
write_lock() {
  local left owner pair ref
  for left in "$LOCKS"/pre-push-*.lock; do
    [ -e "$left" ] || continue
    owner=${left##*/pre-push-}
    owner=${owner%.lock}
    [ -e "/proc/$owner" ] || rm -f "$left"
  done
  for pair in ${locals[@]+"${locals[@]}"}; do
    ref=${pair#* }
    [ "$ref" != HEAD ] || ref=$(git symbolic-ref -q HEAD || echo HEAD)
    echo "$ref"
  done >"$LOCK"
}
if [ ${#shas[@]} -eq 1 ]; then
  MAIN="$ROOT"
  CACHE="${XDG_CACHE_HOME:-$HOME/.cache}"
  for left in "$CACHE"/derbynet-pre-push-*/; do
    left=${left%/}
    [ -d "$left" ] || continue
    owner=${left##*-}
    [ ! -e "/proc/$owner" ] || continue
    for proc in /proc/[0-9]*; do
      case $(readlink "$proc/cwd" 2>/dev/null) in
        "$left"|"$left"/*) kill -KILL "${proc#/proc/}" 2>/dev/null || true ;;
      esac
    done
    git worktree remove --force --force "$left" 2>/dev/null || true
    rm -rf "$left"
    git worktree prune 2>/dev/null || true
    echo "pre-push: removed $left, left by pre-push $owner, which is gone" >&2
  done
  COPY="$CACHE/derbynet-pre-push-$$"
  remove_copy() {
    local status=$? pair now
    trap '' INT HUP TERM
    rm -f "$LOCK"
    if [ -n "$checks_pid" ]; then
      kill -TERM -- "-$checks_pid" 2>/dev/null || true
      for _ in $(seq $((KILL_WAIT * 5))); do
        kill -0 -- "-$checks_pid" 2>/dev/null || break
        sleep 0.2
      done
      kill -KILL -- "-$checks_pid" 2>/dev/null || true
      wait "$checks_pid" 2>/dev/null || true
    fi
    cd "$MAIN"
    git worktree remove --force --force "$COPY" 2>/dev/null || rm -rf "$COPY"
    git worktree prune
    for pair in "${locals[@]}"; do
      now=$(git rev-parse -q --verify "${pair#* }" || true)
      if [ -n "$now" ] && [ "$now" != "${pair%% *}" ]; then
        echo "pre-push: ${pair#* } moved from ${pair:0:8} to ${now:0:8} while the" \
             "checks ran, and git may send the new commit, which they never read;" \
             "push again" >&2
        [ "$status" -ne 0 ] || status=1
      fi
    done
    exit "$status"
  }
  trap remove_copy EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  write_lock
  mkdir -p "$CACHE"
  echo "pre-push: the checks run in $COPY, at ${shas[0]:0:8}" >&2
  git worktree add -q --detach "$COPY" "${shas[0]}"
  ROOT="$COPY"
  cd "$ROOT"
else
  tree_state() {
    git -C "$ROOT" rev-parse HEAD
    git -C "$ROOT" status --porcelain -uall
    git -C "$ROOT" diff HEAD | cksum
    (cd "$ROOT" && git ls-files -o --exclude-standard -z | xargs -0 -r cksum || true)
  }
  START_TREE="$(tree_state)"
  check_tree() {
    local status=$?
    rm -f "$LOCK"
    if [ "$(tree_state)" != "$START_TREE" ]; then
      echo "pre-push: the working tree changed while the checks ran, so their" \
           "results are for no commit. Leave the tree alone until the push" \
           "ends, then push again (#373 retro). It is now:" >&2
      git -C "$ROOT" status --short >&2
      [ "$status" -ne 0 ] || status=1
    fi
    exit "$status"
  }
  trap check_tree EXIT
  write_lock
fi
run_checks() {
# The guides' check, as plan-checks.yml runs it, printing only its failures
# and its count, whatever the push changes: a guide can cite any path.
if [ -n "$pushed" ]; then
  echo "pre-push: server/docs/adr/check-paths.sh --docs docs" >&2
  (cd "$ROOT" && bash server/docs/adr/check-paths.sh --docs docs) \
    | grep -v -e '^ok ' -e '^allowed '
fi
# plan/bin reads server/ and .github/, so plan/tests run on every push.
# source-checks.sh, below, runs them on a push it checks; #311's push ran
# them twice, and the second run alone took 603 s (#311 retro). The line says
# why: #519's implementer started source-checks.sh by hand after an .agents/
# push, then dropped it (#519 retro).
if [ -z "$changed" ]; then
  echo "pre-push: plan/tests alone: the push changes nothing under the" \
       "paths that run tools/source-checks.sh here" >&2
  if ! out="$(python3 -I -m unittest discover -s "$ROOT/plan/tests" 2>&1 </dev/null)"; then
    printf '%s\n' "$out" >&2
    exit 1
  fi
  exit 0
fi

# A push of plan/owner-decisions.md alone runs plan/tests and the source
# checks that read it, which affected-tests finds as it maps a file to its
# tests, not the whole of source-checks.sh, so the hook says
# no `pre-push: tools/source-checks.sh` and the hand-off runs that (D129,
# session retro 2026-11-24). A tool that fails or finds none runs it all.
if [ -n "$decisions" ] && readers="$(python3 -I "$ROOT/plan/bin/affected-tests" \
    --stdin --source-checks --root "$ROOT" <<<plan/owner-decisions.md)" \
    && [ -n "$readers" ]; then
  echo "pre-push: plan/tests" >&2
  if ! out="$(python3 -I -m unittest discover -s "$ROOT/plan/tests" 2>&1 </dev/null)"; then
    printf '%s\n' "$out" >&2
    exit 1
  fi
  echo "pre-push: the source checks that read plan/owner-decisions.md:" $readers >&2
  cd "$ROOT/server"
  mapfile -t readers <<<"$readers"
  env -u DATABASE_URL uv run --locked pytest -q -p no:cacheprovider "${readers[@]}"
  exit 0
fi

echo "pre-push: server/docs/adr/check-paths.sh" >&2
# Print only the failures and the count, not one line per cited path.
bash "$ROOT/server/docs/adr/check-paths.sh" | grep -v -e '^ok ' -e '^allowed '

cd "$ROOT/server"
# makemigrations reads DATABASE_URL; the check needs no particular database.
run() { echo "pre-push: $*" >&2; env -u DATABASE_URL uv run --locked "$@"; }
run ruff check
run ruff format --check
run python tools/convert_generators.py --check
run python tools/reschedule_deviations.py --check
run python manage.py makemigrations --check --dry-run
run python tools/golden_inputs.py --check
echo "pre-push: tools/source-checks.sh, plan/tests among them" >&2
tools/source-checks.sh
}
if [ -n "$COPY" ]; then
  # Job control puts the background job in a process group of its own.
  set -m
  run_checks &
  checks_pid=$!
  set +m
  wait "$checks_pid" && status=0 || status=$?
  checks_pid=
  exit "$status"
fi
run_checks
