# The build context is the repository root (Dockerfile header).  Only what
# the stages copy goes in: server/, the guides for build_docs (#61), and the
# browser timer's sources for build_timer.
*
!server/
!docs/*.md
!docs/img/
!templates/timer.html
!templates/timer-profiles.js
!timer/src/
!timer/derbynet-timer/src/
!lib/jssc.jar
!lib/Java-WebSocket-1.5.2.jar
!lib/json-20210307.jar
server/var/
server/.venv/
# Tests, tools, docs and caches the server never reads at run time.
server/tests/
server/**/tests/
server/conftest.py
server/tools/
server/docs/
server/.hypothesis/
server/.pytest_cache/
server/.ruff_cache/
**/__pycache__/
**/*.pyc
server/ui/static/timer/js/timer/
server/ui/static/timer/css/timer.css
