### 001 edit unknown racer
request: POST action.php
request-body: action=racer.edit&racer=9999&firstname=Nobody
status: 200
content-type: application/json; charset=utf-8
cache-control: no-store, no-cache, must-revalidate
length: 218
body:
{
    "action": {
        "action": "racer.edit",
        "racer": 9999,
        "firstname": "Nobody"
    },
    "outcome": {
        "summary": "success",
        "code": "success",
        "description": ""
    }
}

