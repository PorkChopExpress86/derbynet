### 001 role-list-anonymous
request: GET action.php?query=role.list
status: 200
content-type: application/json; charset=utf-8
set-cookie: PHPSESSID=<value>; path=/
cache-control: no-store, no-cache, must-revalidate
length: 443
body:
{
    "roles": [
        {
            "name": "",
            "timer-message": 0
        },
        {
            "name": "Timer",
            "timer-message": 4096
        },
        {
            "name": "Photo",
            "timer-message": 0
        },
        {
            "name": "RaceCrew",
            "timer-message": 0
        },
        {
            "name": "RaceCoordinator",
            "timer-message": 4096
        }
    ]
}

### 002 login-coordinator
request: POST action.php
request-body: action=role.login&name=RaceCoordinator&password=doyourbest
status: 200
content-type: application/json; charset=utf-8
cache-control: no-store, no-cache, must-revalidate
length: 289
body:
{
    "action": {
        "action": "role.login",
        "name": "RaceCoordinator",
        "password": "..."
    },
    "outcome": {
        "summary": "success",
        "code": "success",
        "description": ""
    },
    "timecheck": "<timecheck>",
    "role": "RaceCoordinator"
}

