### 013 login-stub-xml
request: POST action.php
request-body: action=login&name=RaceCoordinator&password=doyourbest
status: 200
content-type: text/xml; charset=utf-8
cache-control: no-store, no-cache, must-revalidate
length: 227
body:
<?xml version="1.0" encoding="UTF-8"?>
<action-response action="login">
  <failure code="version">Please upgrade your derby-timer.jar
                          (should be using role.login to login)</failure>
</action-response>

### 014 roles-stub-xml
request: GET action.php?query=roles
status: 200
content-type: text/xml; charset=utf-8
cache-control: no-store, no-cache, must-revalidate
length: 227
body:
<?xml version="1.0" encoding="UTF-8"?>
<action-response action="login">
  <failure code="version">Please upgrade your derby-timer.jar</failure>
  <role timer_message="1">Please upgrade derby-timer.jar</role>
</action-response>

