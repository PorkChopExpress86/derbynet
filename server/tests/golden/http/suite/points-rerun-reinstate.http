request-body: action=timer-message&message=FINISHED&lane1=3.400&lane2=3.300&lane3=3.200&lane4=3.100&place1=4&place2=3&place3=2&place4=1
status: 200
content-type: text/xml; charset=utf-8
cache-control: no-store, no-cache, must-revalidate
length: 345
body:
<?xml version="1.0" encoding="UTF-8"?>
<action-response action="timer-message" message="FINISHED" lane1="3.400" lane2="3.300" lane3="3.200" lane4="3.100" place1="4" place2="3" place3="2" place4="1">
