### 012 unknown-xml-action-login-stub
request: POST action.php
request-body: action=login
status: 200
content-type: text/xml; charset=utf-8
length: 227
body:
<?xml version="1.0" encoding="UTF-8"?>
<action-response action="login">
  <failure code="version">Please upgrade your derby-timer.jar
                          (should be using role.login to login)</failure>
</action-response>

### 013 unknown-xml-query-roles-stub
request: GET action.php?query=roles
status: 200
content-type: text/xml; charset=utf-8
length: 227
body:
<?xml version="1.0" encoding="UTF-8"?>
<action-response action="login">
  <failure code="version">Please upgrade your derby-timer.jar</failure>
  <role timer_message="1">Please upgrade derby-timer.jar</role>
</action-response>

### 014 xml-action-timer-message-without-login
request: POST action.php
request-body: action=timer-message&message=HELLO
status: 200
content-type: text/xml; charset=utf-8
length: 199
body:
<?xml version="1.0" encoding="UTF-8"?>
<action-response action="timer-message" message="HELLO"><failure code="notauthorized">Not authorized -- please see race coordinator</failure></action-response>

