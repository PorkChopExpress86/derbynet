### 001 not-a-page
request: GET action.php
status: 200
content-type: text/html; charset=UTF-8
length: 107
body:
<!DOCTYPE html><html><head><title>Not a Page</title></head><body><h1>This is not a page.</h1></body></html>
### 002 unknown-query
request: GET action.php?query=no.such
status: 200
content-type: application/json; charset=utf-8
length: 142
body:
{
    "outcome": {
        "summary": "failure",
        "code": "unrecognized",
        "description": "Unrecognized query: no.such"
    }
}

### 003 unknown-action-encoding-quirks
request: POST action.php
request-body: action=no.such&password=x&n=007&f=1.50&e=1e3&w=%205&h=0x1A&s=a/b&u=%C3%A9&message[recipient]=AA&message[key]=v&list[]=1&list[]=2&a.b=1
status: 200
content-type: application/json; charset=utf-8
length: 517
body:
{
    "action": {
        "action": "no.such",
        "password": "...",
        "n": 7,
        "f": 1.5,
        "e": 1000,
        "w": 5,
        "h": "0x1A",
        "s": "a\/b",
        "u": "\u00e9",
        "message": {
            "recipient": "AA",
            "key": "v"
        },
        "list": [
            1,
            2
        ],
        "a_b": 1
    },
    "outcome": {
        "summary": "failure",
        "code": "unrecognized",
        "description": "Unrecognized action: no.such"
    }
}

### 004 unknown-xml-action-escaping
request: POST action.php
request-body: action=snapshot.no-such&q=%27%22%3C%3E%26
status: 200
content-type: text/xml; charset=utf-8
length: 207
body:
<?xml version="1.0" encoding="UTF-8"?>
<action-response action="snapshot.no-such" q="&#039;&quot;&lt;&gt;&amp;"><failure code="unrecognized">Unrecognized action: snapshot.no-such</failure></action-response>

