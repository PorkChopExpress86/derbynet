### 001 add-scouts-round-1
request: POST action.php
request-body: action=playlist.add&classid=1&round=1&n_times_per_lane=1
status: 200
content-type: application/json; charset=utf-8
length: 559
body:
{
    "action": {
        "action": "playlist.add",
        "classid": 1,
        "round": 1,
        "n_times_per_lane": 1
    },
    "outcome": {
        "summary": "success",
        "code": "success",
        "description": ""
    },
    "queue-entry": {
        "queueid": 1,
        "seq": 1,
        "classid": 1,
        "round": 1,
        "bucket_limit": 0,
        "bucketed": 0,
        "n_times_per_lane": 1,
        "sceneid_at_finish": -1,
        "continue_racing": 0,
        "class": "Scouts",
        "roundname": "Scouts, Round 1"
    }
}

