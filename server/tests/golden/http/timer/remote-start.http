cache-control: no-store, no-cache, must-revalidate
length: 265
body:
<?xml version="1.0" encoding="UTF-8"?>
<action-response action="timer-message" message="HEARTBEAT" remote-start="YES">
  <success/>
  <heat-ready lane-mask="15" class="Wolves" round="1" roundid="1" heat="5" lanes="4"/>
<remote-log send='false'/>
</action-response>

