status: 200
content-type: text/xml; charset=utf-8
length: 406
body:
<?xml version="1.0" encoding="UTF-8"?>
<action-response action="timer-message" message="FINISHED" roundid="1" heat="9" lane1="3.100" lane2="3.200" lane3="3.300" lane4="3.400"><failure code='wrong-heat'>Expecting heat results for roundid 1 and heat 3</failure>
  <success/>
  <heat-ready lane-mask="15" class="Wolves" round="1" roundid="1" heat="3" lanes="4"/>
<remote-log send='false'/>
</action-response>

