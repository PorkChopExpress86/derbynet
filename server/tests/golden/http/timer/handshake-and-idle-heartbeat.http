### 001 login-timer
request: POST action.php
user-agent: DerbyNet-Timer/golden-1.0 (jar)
request-body: action=role.login&name=Timer&password=
status: 200
content-type: application/json; charset=utf-8
set-cookie: PHPSESSID=<value>; path=/
cache-control: no-store, no-cache, must-revalidate
length: 248
body:
{
    "action": {
        "action": "role.login",
        "name": "Timer",
        "password": "..."
    },
    "outcome": {
        "summary": "success",
        "code": "success",
        "description": ""
    },
    "timecheck": "<timecheck>"
}

### 002 hello
request: POST action.php
user-agent: DerbyNet-Timer/golden-1.0 (jar)
request-body: action=timer-message&message=HELLO&interface=golden-jar&build=1.2.3
status: 200
content-type: text/xml; charset=utf-8
cache-control: no-store, no-cache, must-revalidate
length: 205
body:
<?xml version="1.0" encoding="UTF-8"?>
<action-response action="timer-message" message="HELLO" interface="golden-jar" build="1.2.3">
  <success/>
    <query/>
<remote-log send='false'/>
</action-response>

