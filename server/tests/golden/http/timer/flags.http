cache-control: no-store, no-cache, must-revalidate
length: 718
body:
{
    "ports": "\/dev\/ttyUSB0,\/dev\/ttyUSB1",
    "devices": [
        {
            "name": "TestTimer",
            "description": "Test Timer"
        },
