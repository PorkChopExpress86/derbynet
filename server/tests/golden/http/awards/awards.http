### 004 import missing type
request: POST action.php
request-body: action=award.import&awardname=Nothing
status: 200
content-type: application/json; charset=utf-8
cache-control: no-store, no-cache, must-revalidate
length: 238
body:
{
    "action": {
        "action": "award.import",
        "awardname": "Nothing"
    },
    "outcome": {
        "summary": "failure",
        "code": "missingrequired",
        "description": "Missing required field awardtype"
    }
}

### 005 import empty name
request: POST action.php
request-body: action=award.import&awardname=%20&awardtype=Other
status: 200
content-type: application/json; charset=utf-8
cache-control: no-store, no-cache, must-revalidate
length: 252
body:
{
    "action": {
        "action": "award.import",
        "awardname": " ",
        "awardtype": "Other"
    },
    "outcome": {
        "summary": "failure",
        "code": "emptyaward",
        "description": "Award name can\\'t be empty"
    }
}

### 006 import unknown type
request: POST action.php
request-body: action=award.import&awardname=X&awardtype=Design
status: 200
content-type: application/json; charset=utf-8
cache-control: no-store, no-cache, must-revalidate
length: 358
body:
{
    "action": {
        "action": "award.import",
        "awardname": "X",
        "awardtype": "Design"
    },
    "outcome": {
        "summary": "failure",
        "code": "unknownawardtype",
        "description": "Unrecognized award type.  Award type must be one of: Ad Hoc, Design General, Design Trophy, Other, Speed General, Speed Trophy"
    }
}

