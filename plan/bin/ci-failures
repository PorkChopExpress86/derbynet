#!/usr/bin/env python3
"""Lists each test that failed on a PR's current checks, and whether it also
failed on a recent master run: a known flake, not the PR's doing.

Usage: plan/bin/ci-failures <pr> [--master-runs N]   (default 15)

Reads the failed checks' logs (`gh run view --log-failed`) for pytest's
`FAILED path::test` and `ERROR path::test` lines, then the logs of the last
N failed runs on master. Prints one line per failing test:

    known  <test id>  master <sha> run <id>
    new    <test id>

and, for the failed jobs of a run whose log names no test (a lint or a setup
step), a `no test id` line, then one line per job with the first step that
failed and the last error line it printed, and the error line most of those
jobs share:

    no test id  run <id>: 2 jobs
      ui (sqlite)  step "Install Chromium": Error: Installation process ...
      shell (sqlite, group 1)  step "Start the Django server": E: Unable ...
      2 of 2 jobs printed: Temporary failure resolving 'azure.archive...'

and when every failed job of every failed run stopped in a setup step, all
of a run's jobs printed that one line, the line names the network or a
service failing (a name that does not resolve, a connection timed out or
refused, a failed fetch, an HTTP 5xx, a rate limit, a TLS handshake), and no
test id appears anywhere, a last line says it is an outage, not a code
failure:

    outage: every failure is in a setup step, before any test; ...

A setup step is one whose name starts with Set up, Install, Fetch, Start,
Build, Initialize, Checkout or Run actions/, and names no check or
comparison ("Build the CSS offline, with no Node, and compare it" is a
check). A run of one failed job never counts, since one job shares a line
with nobody. A stale uv.lock or conflicting migrations fail every job's
setup with one line too, and are code failures.

PR #284's run 43054997286 failed 10 jobs at apt, and the lead read their
logs by hand to find the mirror they all timed out on, which #285 fixed
(#282 retro). Exits 1 when a test is new or a job has no test id, 0 when
every failure is known from master. #212's `test_vote.py` sort test failed
on ui (postgres), and the same test had failed on master's push of 0141fa3b;
only a 50-run local repro showed it was no regression (#212 retro).
"""

import json
import os
import re
import subprocess
import sys

TEST_ID = re.compile(r"\b(?:FAILED|ERROR) ([\w/.-]+\.py::\S+)")
RUN = re.compile(r"/actions/runs/(\d+)")


def gh(*args: str) -> str:
    command = [os.environ.get("GH", "gh"), *args]
    return subprocess.run(command, check=True, capture_output=True, text=True).stdout


# A `--log-failed` line is "<job>\t<step>\t<timestamp> <text>".
STAMP = re.compile(r"^\ufeff?\d{4}-\d\d-\d\dT[\d:.]+Z ?")
ANSI = re.compile(r"\x1b\[[0-9;]*m")
ERROR_LINE = re.compile(
    r"(?i)\b(error|fail\w*|unable|fatal|denied|refused|timed out|not found)\b"
)


def failed_tests(run_id: str, repo: str) -> set[str]:
    return set(TEST_ID.findall(failed_log(run_id, repo)))


def failed_log(run_id: str, repo: str) -> str:
    return gh("run", "view", run_id, "--repo", repo, "--log-failed")


def jobs_of(log: str) -> dict[str, list[tuple[str, str]]]:
    """Each job's (step, text) lines, in log order."""
    jobs: dict[str, list[tuple[str, str]]] = {}
    for raw in log.splitlines():
        job, step, text = raw.split("\t", 2) if raw.count("\t") >= 2 else ("", "", raw)
        jobs.setdefault(job, []).append(
            (step, ANSI.sub("", STAMP.sub("", text)).strip())
        )
    return jobs


def failed_step(lines: list[tuple[str, str]]) -> tuple[str, list[str]]:
    """The first step that printed `##[error]`, and its error lines. A later
    step that fails only because that one did (a log dump) is left out."""
    steps = [step for step, text in lines if text.startswith("##[error]")]
    step = steps[0] if steps else lines[-1][0]
    errors = [
        text
        for s, text in lines
        if s == step
        and (ERROR_LINE.search(text) or NETWORK.search(text))
        and not text.startswith("##[")
    ]
    return step, errors


SETUP_STEP = re.compile(
    r"^(?!.*\b(?:check(?:s|ed|ing)?|compar(?:e|es|ed|ing))\b)"
    r"(?:Set up|Install|Fetch|Start|Build|Initialize|Checkout|Run actions/)",
    re.I,
)
NETWORK = re.compile(
    r"(?i)temporary failure resolving|could not resolve|name or service not known"
    r"|connection (?:timed out|refused|reset)|timed out|failed to fetch"
    r"|unable to fetch|\b(?:HTTP\S*|status|error) ?5\d\d\b|\b50[234]\b"
    r"|service unavailable|bad gateway|rate limit|tls handshake"
    r"|ETIMEDOUT|ECONNRESET|ECONNREFUSED|EAI_AGAIN"
)
OUTAGE = (
    "outage: every failure is in a setup step, before any test; probe the "
    "dependency the shared line names, and work around it in a PR of its own "
    "or report it (plan/implement-all-tickets.md, Stop and report)"
)


def no_test_id(run_id: str, log: str, names: str) -> tuple[list[str], bool]:
    """The report for the jobs of `log` that name no test id, and whether
    the run is an outage: no test id in the log, every failed job stopped in
    a setup step, and every one printed the shared line, a network or
    service failure."""
    if not log.strip():
        return [
            f"no test id  run {run_id} ({names}): its log is empty; read it on GitHub"
        ], False
    jobs = {
        job: lines
        for job, lines in jobs_of(log).items()
        if not any(TEST_ID.search(text) for _, text in lines)
    }
    if not jobs:
        return [], False
    out = [f"no test id  run {run_id}: {len(jobs)} job{'s' * (len(jobs) > 1)}"]
    # Each error line's (jobs that printed it, times printed), so the cause
    # the jobs share outranks each job's own last line.
    shared: dict[str, tuple[int, int]] = {}
    setup = True
    for job, lines in jobs.items():
        step, errors = failed_step(lines)
        setup = setup and SETUP_STEP.match(step) is not None
        last = errors[-1] if errors else "no error line; read its log"
        out.append(f'  {job or names}  step "{step}": {last}')
        for text in set(errors):
            shared[text] = (
                shared.get(text, (0, 0))[0] + 1,
                shared.get(text, (0, 0))[1] + errors.count(text),
            )
    outage = False
    if len(jobs) > 1 and shared:
        text, (n, _) = max(shared.items(), key=lambda kv: kv[1])
        if n > 1:
            out.append(f"  {n} of {len(jobs)} jobs printed: {text}")
        outage = (
            setup
            and n == len(jobs)
            and NETWORK.search(text) is not None
            and not TEST_ID.search(log)
        )
    return out, outage


def main(argv: list[str]) -> int:
    if not argv or not argv[0].isdigit():
        print("usage: ci-failures <pr> [--master-runs N]", file=sys.stderr)
        return 2
    pr = argv[0]
    master_runs = int(argv[2]) if argv[1:2] == ["--master-runs"] else 15
    repo = os.environ.get("REPO", "PorkChopExpress86/derbynet")

    checks = json.loads(
        gh("pr", "checks", pr, "--repo", repo, "--json", "bucket,name,link")
    )
    failed = [c for c in checks if c["bucket"] == "fail"]
    if not failed:
        print(f"PR #{pr}: no failed check")
        return 0
    tests: set[str] = set()
    status = 0
    outages = []
    for run_id in sorted({m.group(1) for c in failed if (m := RUN.search(c["link"]))}):
        log = failed_log(run_id, repo)
        tests |= set(TEST_ID.findall(log))
        names = ", ".join(c["name"] for c in failed if f"/runs/{run_id}/" in c["link"])
        report, outage = no_test_id(run_id, log, names)
        outages.append(outage)
        if report:
            print("\n".join(report))
            status = 1

    known: dict[str, str] = {}
    if tests:
        runs = json.loads(
            gh(
                "run", "list", "--repo", repo, "--branch", "master",
                "--status", "failure", "--limit", str(master_runs),
                "--json", "databaseId,headSha",
            )
        )
        for run in runs:
            for test in failed_tests(str(run["databaseId"]), repo) & (tests - known.keys()):
                known[test] = f"master {run['headSha'][:8]} run {run['databaseId']}"
    for test in sorted(tests):
        if test in known:
            print(f"known  {test}  {known[test]}")
        else:
            print(f"new    {test}")
            status = 1
    if outages and all(outages):
        print(OUTAGE)
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
