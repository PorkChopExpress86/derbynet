#!/usr/bin/env python3
"""Lists each `testing/` shell suite an issue names, and whether
`.github/workflows/server.yml` runs it against Django.

Usage: plan/bin/ci-suites <number>

Exits 1 when a named suite is missing from the workflow. A suite that still
waits on another ticket stays missing; say which ticket in the PR body.

It also lists the parity gate's entries (`server/tools/parity_gate.py`: a
step it skips, waits on, or lets differ) that name the ticket or one of its
suites. An entry that is a constant (`"snapshot_get": _SNAPSHOT,`) is read
as the constant's text. Lifting
one changes what the gate compares, so raise it at the start, not after the
endpoints exist (#54 retro). #204's entry named the legacy pages, not #204
(#204 retro).
"""

import json
import os
import re
import subprocess
import sys
from pathlib import Path

SUITE = re.compile(r"\btesting/([\w-]+\.sh)\b")
GATE_ENTRY = re.compile(r'^\s*"([^"]+)":\s*(.+)$', re.MULTILINE)
HELPERS = {"common.sh"}  # sourced by the suites, never run alone
CONSTANT = re.compile(r"^([A-Z_][A-Z0-9_]*),?$")


def constant_text(gate: str, name: str) -> str | None:
    """The text a module-level `NAME = ...` assigns: its line, or from its
    "(" to the ")" that closes it at the start of a line."""
    found = re.search(
        rf"^{name}\b[^=\n]*= (\(.*?^\)|[^\n]*)", gate, re.MULTILINE | re.DOTALL
    )
    return " ".join(found[1].split()) if found else None


def main(argv: list[str]) -> int:
    if len(argv) != 1 or not argv[0].isdigit():
        print("usage: ci-suites <number>", file=sys.stderr)
        return 2
    gh = os.environ.get("GH", "gh")
    repo = os.environ.get("REPO", "PorkChopExpress86/derbynet")
    body = json.loads(
        subprocess.run(
            [gh, "issue", "view", argv[0], "--repo", repo, "--json", "body"],
            check=True,
            capture_output=True,
            text=True,
        ).stdout
    )["body"]
    root = Path(__file__).resolve().parents[2]
    workflow = (root / ".github" / "workflows" / "server.yml").read_text()
    ran = set(re.findall(r"bash testing/([\w-]+\.sh)", workflow))
    missing = 0
    suites = sorted(set(SUITE.findall(body)) - HELPERS)
    for suite in suites:
        if suite in ran:
            print(f"in CI    testing/{suite}")
        else:
            missing += 1
            print(f"MISSING  testing/{suite}")
    gate_path = os.environ.get("PARITY_GATE")  # a fake gate, for plan/tests
    gate = Path(gate_path or root / "server" / "tools" / "parity_gate.py").read_text()
    ticket = re.compile(rf"#{argv[0]}\b")
    listed = set()
    for step, rest in GATE_ENTRY.findall(gate):
        named = CONSTANT.match(rest.strip())
        if named:
            rest = constant_text(gate, named[1]) or rest
        # A step's label is its script, its arguments, and " (2)" for a rerun.
        if ticket.search(rest) or step.split()[0] in suites:
            # An entry that goes on over several lines opens with "(".
            entry = rest.strip() if rest.strip() != "(" else "(several lines)"
            line = f"PARITY   {step}: {entry}"
            if line not in listed:
                listed.add(line)
                print(line)
    return 1 if missing else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
