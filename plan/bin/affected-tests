    'pyproject.toml': 'changes the dependencies and the pytest options',
    'uv.lock': 'changes the dependencies',
}
TIMER_BUILD = ('templates/timer.html', 'templates/timer-profiles.js', 'timer/')

TIMING = re.compile(
    r'clock|setTimeout|setInterval|requestAnimationFrame|wait_for_timeout|'
    r'time\.sleep|monotonic|animation|NUDGE_MS|kioskNudge|\.route\(|'
    r'expect_request|expect_response|expect_event')
MEASURES = re.compile(
    r'bounding_box\(|getBoundingClientRect|getClientRects|scrollWidth|'
    r'scrollHeight|clientWidth|clientHeight|offsetWidth|offsetHeight|'
    r'fontSize|font-size|font_size')
DB_CODE = re.compile(
    r'django\.db|\.objects\b|transaction\.|select_for_update|\.raw\(|'
    r'cursor\(|RawSQL|connection\.|Subquery|'
    r'OuterRef|bulk_create|bulk_update|update_or_create|get_or_create')
# A queryset's methods, which a dict or a string names too: they count only
# in a module that imports Django. tools/operand_mutants.py's docstring and
# regex name `.filter(`, and asked for Postgres (#358 review); no module
# under server/ that imports no Django calls one on a queryset (#336 retro).
QUERYSET = re.compile(
    r'\.filter\(|\.exclude\(|\.annotate\(|\.aggregate\(|\.values(_list)?\(|'
    r'\.order_by\(|\bF\(|\bQ\(')
DJANGO_IMPORT = re.compile(r'^\s*(?:from|import)\s+django\b', re.M)
RAW_SQL = re.compile(r'cursor\(|\.raw\(|RawSQL|connection\.vendor')
# What tools/operand_mutants.py reads conditions and min()/max() calls from,
# and the folders of code nobody here writes by hand.
MUTANT_SOURCES = ('.py', '.js', '.css')
NOT_HAND_WRITTEN = {'migrations', 'vendor'}
BROWSER_MARK = re.compile(r'^pytestmark\s*=.*mark\.browser', re.MULTILINE)
BROWSER_DECORATOR = re.compile(r'^@pytest\.mark\.browser\b', re.MULTILINE)
TEMPLATE_TAG = re.compile(
    r'''\{%\s*(extends|include|static|component)\s+['"]([^'"]+)['"]''')


@dataclass
class Plan:
    root: Path
    from_git: bool
    base: str
    covers: dict = field(default_factory=dict)  # file -> [(rule, note, [targets])]
    everything: list = field(default_factory=list)
    postgres: list = field(default_factory=list)
    commands: list = field(default_factory=list)
    changed_browser_tests: list = field(default_factory=list)
    changed_tests: list = field(default_factory=list)
    changed_source: list = field(default_factory=list)
    # A helper's docstrings make claims too: #348's pause_clock_at cited
    # the review's probe, which no test held (#348 retro).
    changed_helpers: list = field(default_factory=list)
    untracked: list = field(default_factory=list)
    merge_base: str = None

    def add(self, path, rule, note, targets=()):
        self.covers.setdefault(path, []).append((rule, note, list(targets)))

    def command(self, line):
        if line not in self.commands:
            self.commands.append(line)


# --- the tree --------------------------------------------------------------

class Tree:
    """What the rules read: the test files, their imports, the templates."""

    def __init__(self, root: Path):
        self.root = root
        self.server = root / SERVER
        self._tests = None
        self._test_files = None
        self._imports = None
        self._importing = None  # module name: the files that import it
        self._graph = None
        self._website = None
        self._users = {}
        self._texts = {}

    def exists(self, rel):
        return (self.server / rel).exists()

    def text(self, rel):
        if rel not in self._texts:
            try:
                self._texts[rel] = (self.server / rel).read_text(errors='replace')
            except OSError:
                self._texts[rel] = ''
        return self._texts[rel]

    def test_dirs_under(self, rel_dir):
        """The `tests` folders under `rel_dir`, but not one inside another."""
        base = self.server / rel_dir
        found = []
        for p in sorted(base.rglob('tests')) if base.is_dir() else []:
            rel = p.relative_to(self.server)
            if p.is_dir() and 'tests' not in rel.parts[:-1] and '.venv' not in rel.parts:
                found.append(str(rel))
        return found

    def website_names(self):
        if self._website is None:
            web = self.root / 'website'
            self._website = {p.name for p in web.rglob('*')} if web.is_dir() else set()
        return self._website

    def python_in_tests(self):
        """Every .py under a `tests` folder of server/, and every conftest,
        as a relative path."""
        if self._tests is None:
            out = []
            for p in self.server.rglob('*.py'):
                rel = p.relative_to(self.server)
                if '.venv' in rel.parts or (
                        'tests' not in rel.parts[:-1] and rel.name != 'conftest.py'):
                    continue
                out.append(str(rel))
            self._tests = sorted(out)
        return self._tests

    def test_files(self):
        if self._test_files is None:
            self._test_files = tuple(p for p in self.python_in_tests()
                                     if Path(p).name.startswith('test_'))
        return list(self._test_files)

    def imports(self):
        """Each test-folder module's imported names: `import a.b` gives a.b,
        `from a import b` gives a and a.b; relative imports are resolved. A
        dotted path a `patch` or `setattr` call names counts too:
        `mock.patch("core.database_scripts.call_command")` in
        test_database_execute.py and `monkeypatch.setattr(
        "legacy_api.handlers.race_control.poll_coordinator", ...)` in
        test_dashboard.py reach their modules without an import."""
        if self._imports is None:
            self._imports = {}
            for rel in self.python_in_tests():
                names = set()
                try:
                    tree = ast.parse(self.text(rel))
                except SyntaxError:
                    # Syntax newer than this Python (the server needs 3.14):
                    # read the imports and patch paths as text instead of
                    # dropping them.
                    tree = ast.Module(body=[], type_ignores=[])
                    names.update(text_imports(self.text(rel)))
                package = module_name(rel).rsplit('.', 1)[0]
                if Path(rel).name == '__init__.py':
                    package = module_name(rel)
                for node in ast.walk(tree):
                    if isinstance(node, ast.Import):
                        names.update(a.name for a in node.names)
                    elif isinstance(node, ast.ImportFrom):
                        mod = node.module or ''
                        if node.level:
                            parts = package.split('.')
                            parts = parts[:len(parts) - node.level + 1]
                            mod = '.'.join(parts + ([mod] if mod else []))
                        names.add(mod)
                        names.update(f'{mod}.{a.name}' for a in node.names)
                    elif isinstance(node, ast.Call) and node.args \
                            and call_name(node.func) in PATCH_CALLS \
                            and isinstance(node.args[0], ast.Constant) \
                            and isinstance(node.args[0].value, str) \
                            and DOTTED.fullmatch(node.args[0].value):
                        names.add(node.args[0].value)
                self._imports[rel] = names
        return self._imports

    def reach(self, module):
        """The test-folder files that import `module`, directly or through
        another test-folder file that does, a test file among them:
        test_kiosk_banner.py imports open_kiosk from test_kiosk_pages.py, and
        test_database_check.py SERVICE_VIOLATIONS from test_invariants.py,
        which imports core/tests/db.py (#371 retro). A file imports a module
        when it imports it or a name inside it: `a.b.c` imports a, a.b and
        a.b.c."""
        if self._importing is None:
            self._importing = {}
            for rel, names in self.imports().items():
                for name in names:
                    parts = name.split('.')
                    for i in range(1, len(parts) + 1):
                        self._importing.setdefault('.'.join(parts[:i]), set()).add(rel)
        reached, todo, found = {module}, [module], set()
        while todo:
            users = self._importing.get(todo.pop(), set())
            found |= users
            new = {module_name(rel) for rel in users} - reached
            reached |= new
            todo.extend(new)
        return sorted(found)

    def importers(self, module):
        """The test files that import `module`, directly or through another
        test-folder file, and the conftests that do."""
        found = self.reach(module)
        return ([rel for rel in found if Path(rel).name.startswith('test_')],
                [rel for rel in found if Path(rel).name == 'conftest.py'])

    def mentions(self, words):
        """The test files whose text names one of `words`, as a whole word:
        kiosk.js is not named by kiosk.json."""
        # The plain `in` first: a pattern that opens on a lookbehind scans
        # slowly, and every template in RealTree's test pays it (#312 retro).
        found = [(w, re.compile(rf'(?<![\w-]){re.escape(w)}(?![\w-])'))
                 for w in words if w]
        return sorted(rel for rel in self.test_files()
                      if any(w in self.text(rel) and f.search(self.text(rel))
                             for w, f in found))

    def source_checks(self):
        """The test files tools/source-checks.sh runs."""
        text = self.text('tools/source-checks.sh')
        return set(re.findall(r'^\s+"?([\w/]+\.py)', text, re.MULTILINE))

    def named(self, tokens, dirs=('ui/tests', BROWSER_DIR)):
        """The test files in `dirs` whose file name carries one of `tokens`."""
        out = []
        for rel in self.test_files():
            if str(Path(rel).parent) in dirs and \
                    any(t in Path(rel).stem for t in tokens):
                out.append(rel)
        return sorted(out)

    def graph(self):
        """Template name -> the templates and static paths it names."""
        if self._graph is None:
            self._graph = {}
            for p in self.server.rglob('templates/**/*.html'):
                rel = p.relative_to(self.server)
                if '.venv' in rel.parts:
                    continue
                name = template_name(str(rel))
                uses = set()
                for kind, ref in TEMPLATE_TAG.findall(p.read_text(errors='replace')):
                    if kind == 'static':
                        uses.add(('static', ref))
                    elif kind == 'component':
                        uses.add(('template', f'ui/components/{ref}.html'))
                    else:
                        uses.add(('template', ref))
                self._graph[name] = (str(rel), uses)
        return self._graph

    def pages_using(self, kind, ref):
        """The templates that load `ref`, through their extends and includes."""
        if (kind, ref) not in self._users:
            self._users[kind, ref] = frozenset(self._pages_using(kind, ref))
        return self._users[kind, ref]

    def _pages_using(self, kind, ref):
        graph = self.graph()
        users = set()
        frontier = {(kind, ref)}
        while frontier:
            new = set()
            for name, (_, uses) in graph.items():
                if name not in users and uses & frontier:
                    users.add(name)
                    new.add(('template', name))
            frontier = new
        return users


PATCH_CALLS = {'patch', 'setattr', 'delattr'}
DOTTED = re.compile(r'[A-Za-z_]\w*(\.[A-Za-z_]\w*)+')


def call_name(func):
    """`patch` for `mock.patch(...)`, `patch(...)` and `monkeypatch.setattr`'s
    `setattr`."""
    if isinstance(func, ast.Attribute):
        return func.attr
    return func.id if isinstance(func, ast.Name) else None


def module_name(rel):
    parts = list(Path(rel).with_suffix('').parts)
    if parts[-1] == '__init__':
        parts = parts[:-1]
    return '.'.join(parts)


def template_name(rel):
    parts = Path(rel).parts
    return '/'.join(parts[parts.index('templates') + 1:])


def static_name(rel):
    parts = Path(rel).parts
    return '/'.join(parts[parts.index('static') + 1:])


def tokens_for(name):
    if name in UI_KEYS:
        return UI_KEYS[name]
    return (name, name[:-1]) if name.endswith('s') else (name,)


def in_tests(rel):
    return 'tests' in Path(rel).parts[:-1]


def run_kind(tree, target):
    """'browser' for a target only `-m browser` runs, 'both' for a file with
    browser tests beside others (test_browser_timeout.py), else 'plain'."""
    if target == BROWSER_DIR or target.startswith(BROWSER_DIR + '/'):
        return 'browser'
    if not target.endswith('.py'):
        inside = [r for r in tree.test_files() if r.startswith(target + '/')
                  or target == '.']
        return 'both' if any(run_kind(tree, r) != 'plain' for r in inside) else 'plain'
    text = tree.text(target)
    if BROWSER_MARK.search(text):
        return 'browser'
    return 'both' if BROWSER_DECORATOR.search(text) else 'plain'


def is_browser_test(tree, rel):
    return run_kind(tree, rel) != 'plain'


def nearest_tests(tree, rel):
    """The `tests` folder nearest above `rel`: racing/engine/x.py gives
    racing/engine/tests."""
    path = Path(rel).parent
    while str(path) not in ('.', ''):
        if (tree.server / path / 'tests').is_dir():
            return str(path / 'tests')
        path = path.parent
    return 'tests'


def app_of(rel):
    return Path(rel).parts[0] if len(Path(rel).parts) > 1 else None


# --- the rules -------------------------------------------------------------
# Each rule is (name, matches(path), cover(plan, tree, path)). `path` is
# repo-relative. A rule that matches and maps the file to nothing on purpose
# says why with a note; one that finds no target leaves the file to the
# fallback.

def s(path):
    """The path under server/, or None."""
    return path[len(SERVER) + 1:] if path.startswith(SERVER + '/') else None


SETTINGS = re.compile(r'derbynet/settings\w*\.py')


def match_everything(path):
    rel = s(path)
    if path.startswith('.github/'):
        return True
    if rel is None:
        return False
    return (Path(rel).name == 'conftest.py' or rel in EVERYTHING
            or SETTINGS.fullmatch(rel) is not None)


def cover_everything(plan, tree, path):
    rel = s(path)
    if path.startswith('.github/'):
        why = 'a CI workflow or its script: CI runs what this file says'
    elif rel in EVERYTHING:
        why = EVERYTHING[rel]
    elif Path(rel).name == 'conftest.py':
        why = ('a shared conftest: its fixtures and hooks run in every test it '
               'collects (#282: the browser conftest hook ran in every collection)')
    else:
        why = 'the settings every test runs with, the database settings among them'
    plan.everything.append(f'{path}: {why}')
    if rel is not None and SETTINGS.fullmatch(rel):
        plan.postgres.append(f'{path}: the database settings')
    plan.add(path, 'everything', why)


def match_guide(path):
    p = Path(path)
    return (p.parent == Path('docs') and p.suffix == '.md') or path.startswith('docs/img/')


def cover_guide(plan, tree, path):
    """A guide is rendered by the docs build and read by its check, which
    run only in CI otherwise: #61's fix round left a fence open in
    install-docker.md that swallowed its Upgrade section (#61 retro). The
    browser test draws each guide (its fit, its images, axe)."""
    plan.command('bash docs/adr/check-paths.sh --docs ../docs')
    plan.add(path, 'guide', 'a guide served under /docs/ (#61): the docs build '
             'renders it (ui/docs/build.py refuses a fence line it does not take as a fence), '
             'the browser test draws it, and docs/adr/check-paths.sh --docs checks its '
             'links, anchors and paths',
             ['ui/tests/test_docs.py', 'tests/test_check_paths.py',
              'ui/tests/browser/test_docs.py'])


def match_docs(path):
    p = Path(path)
    if (s(path) is not None and in_tests(s(path))) or match_guide(path):
        return False
    return p.suffix in ('.md', '.rst', '.txt') or p.name in ('LICENSE', 'COPYING') \
        or path.startswith('docs/')


def cover_docs(plan, tree, path):
    plan.add(path, 'docs', 'docs only: no pytest target. tools/source-checks.sh '
             "reads its PHP claims and cites (test_php_claims.py, "
             "test_php_cite_lines.py), and the pre-push hook its ADR paths")


def match_website(path):
    return path.startswith('website/') or path == 'build.xml' or (
        path.startswith('templates/') and not path.startswith(TIMER_BUILD))


def cover_website(plan, tree, path):
    name = Path(path).name
    note = ('the PHP server is frozen (CLAUDE.md): fix the defect in the port '
            'instead. Tests that name the file:')
    targets = tree.mentions([name])
    if path.startswith('website/inc/generators/'):
        plan.command('uv run python tools/convert_generators.py --check')
        targets.append('racing/engine/tests/test_generator_tables.py')
    if not targets:
        note = ('the PHP server is frozen (CLAUDE.md): fix the defect in the port '
                'instead. No test names it; tools/source-checks.sh reads PHP cites')
    plan.add(path, 'website', note, targets)


def match_plan_tools(path):
    return (path.startswith('plan/') and not path.endswith('.md')) \
        or path.startswith('.githooks/')


def python_script(tree, path):
    """A `.py` file, or a script with no extension whose shebang names
    Python, as tools/operand_mutants.py reads them."""
    if path.endswith('.py'):
        return (tree.root / path).is_file()
    if Path(path).suffix:
        return False
    try:
        with open(tree.root / path, 'rb') as f:
            first = f.readline()
    except OSError:
        return False
    return first.startswith(b'#!') and b'python' in first


def cover_plan_tools(plan, tree, path):
    # #320's diff was a plan/bin tool and its test, and neither line of the
    # "before the first hand-off run" step was printed (#320 retro).
    if python_script(tree, path):
        rel = f'../{path}'
        if Path(path).name.startswith('test_'):
            plan.changed_tests.append(rel)
        else:
            plan.changed_source.append(rel)
    # tools/source-checks.sh, printed for every diff, runs plan/tests: a line
    # of their own ran them twice (#338).
    plan.add(path, 'plan-tools', 'plan/tests, which test the plan tools and the '
             'pre-push hook: tools/source-checks.sh runs them')
    # A server test that runs a plan tool where plan/tests can't, such as
    # pytest itself for affected-tests' XUNIT (#336 review, M1).
    named = tree.mentions([path])
    if named:
        plan.add(path, 'plan-tools', 'the server tests that name it', named)


def match_timer_build(path):
    return path.startswith(TIMER_BUILD)


def cover_timer_build(plan, tree, path):
    plan.add(path, 'timer-build', 'built into /timer.php (server/README.md, '
             '"The browser timer")',
             [f'{BROWSER_DIR}/test_timer.py', 'ui/tests/test_timer_pages.py'])


def match_testing(path):
    return path.startswith('testing/')


def cover_testing(plan, tree, path):
    targets = tree.mentions([Path(path).name])
    note = ('a shell suite or its data: the tests that name it. CI runs the '
            'shell suites against Django; testing/README.md runs one locally')
    if not targets:
        targets = ['legacy_api/tests/test_testing_scripts.py',
                   'tests/test_golden_inputs.py']
        note = ('no test names it: the tests that read testing/ as a whole. CI '
                'runs the shell suites against Django')
    plan.add(path, 'testing', note, targets)
    # A -cases.sh runs its script once per bound against a live server, and
    # CI does not run it. #399's cases first ran after the first push, and
    # the dump guard and the missing-log path each took a second push (#399
    # retro).
    for cases in cases_scripts(tree, path):
        plan.command(f'bash ../{cases} <base_url>  # a running server '
                     '(testing/README.md); before the first push')


def cases_scripts(tree, path):
    """The testing/*-cases.sh that are `path` or name it, as
    race-with-derby-timer-cases.sh names its script and its stand-in
    timer-stand-in/java."""
    rel = path[len('testing/'):]
    found = []
    for cases in sorted((tree.root / 'testing').glob('*-cases.sh')):
        if cases.name == rel or rel in cases.read_text(errors='replace'):
            found.append(f'testing/{cases.name}')
    return found


def match_test_file(path):
    rel = s(path)
    return rel is not None and in_tests(rel) and Path(rel).name.startswith('test_') \
        and rel.endswith('.py')


def cover_test_file(plan, tree, path):
    rel = s(path)
    if not tree.exists(rel):
        plan.add(path, 'test-file', 'deleted: nothing of its own to run')
        return
    plan.changed_tests.append(rel)
    if is_browser_test(tree, rel):
        plan.changed_browser_tests.append(rel)
    tests, conftests = tree.importers(module_name(rel))
    if not tests + conftests:
        plan.add(path, 'test-file', 'the test file itself', [rel])
        return
    dirs = [str(Path(c).parent) for c in conftests]
    if '.' in dirs:
        plan.everything.append(f'{path}: the root conftest imports it')
    plan.add(path, 'test-file', 'the test file itself, and the tests and conftest '
             'folders that import it (#371 retro)',
             [rel] + tests + [d for d in dirs if d != '.'])


def match_test_helper(path):
    rel = s(path)
    return rel is not None and in_tests(rel) and rel.endswith('.py') \
        and not Path(rel).name.startswith('test_') and Path(rel).name != 'conftest.py'


def cover_test_helper(plan, tree, path):
    rel = s(path)
    if rel == 'core/tests/populated.py':
        plan.postgres.append(f'{path}: the populated event every event-scoped '
                             'model needs a row in')
    try:
        if not plan.from_git:
            raise NotAddition('--stdin has no BASE to compare with')
        if not tree.exists(rel):
            raise NotAddition('deleted')
        functions, imports = additions(base_text(plan, rel), tree.text(rel))
        tests, conftests, naming = namers(tree, rel, functions)
    except NotAddition as why:
        tests, conftests = tree.importers(module_name(rel))
        note = ('a test helper: the tests and conftest folders that import it; its '
                f'diff is no pure addition (#371): {why}')
        root_why = 'the root conftest imports it'
    else:
        also = f'; beside them it adds the import of {", ".join(imports)}' \
            if imports else ''
        note = (f'a test helper (#371): adds {", ".join(functions)}, which these files '
                f'call: {", ".join(naming)}; and the tests and conftest folders that '
                f'import one of them{also}')
        root_why = 'the root conftest names what it adds'
    dirs = [str(Path(c).parent) for c in conftests]
    if '.' in dirs:
        plan.everything.append(f'{path}: {root_why}')
    targets = tests + [d for d in dirs if d != '.']
    if tree.exists(rel):  # match_test_helper took only .py files
        plan.changed_helpers.append(rel)
    plan.add(path, 'test-helper', note, targets)


def match_test_data(path):
    rel = s(path)
    return rel is not None and in_tests(rel) and not rel.endswith('.py')


def cover_test_data(plan, tree, path):
    rel = Path(s(path))
    words = [rel.name]
    targets = tree.mentions(words)
    for parent in rel.parents:
        if targets or parent.name in ('tests', ''):
            break
        targets = tree.mentions([f'{parent.name}/', f'"{parent.name}"'])
    plan.add(path, 'test-data', 'test data: the tests that name it or its folder',
             targets)


def match_model(path):
    rel = s(path)
    return rel is not None and not in_tests(rel) and (
        Path(rel).name == 'models.py' or 'models' in Path(rel).parts[:-1]
        or 'migrations' in Path(rel).parts[:-1])


def cover_model(plan, tree, path):
    plan.postgres.append(f'{path}: a model or a migration')
    plan.command('uv run python manage.py makemigrations --check --dry-run')
    plan.add(path, 'model', 'a model or migration: core/tests (populated.py, the '
             'invariants) and the registry and event-leak checks',
             ['core/tests', *REGISTRY_CHECKS])


def match_service(path):
    rel = s(path)
    return rel is not None and not in_tests(rel) and rel.endswith('.py') and (
        Path(rel).name == 'services.py' or 'services' in Path(rel).parts[:-1])


def cover_service(plan, tree, path):
    plan.postgres.append(f'{path}: a service')
    plan.add(path, 'service', 'a service: the registry and event-leak checks, '
             'and the replay suites, which hold PHP\'s state after each step',
             [*REGISTRY_CHECKS, *REPLAY_SUITES])


def match_handler(path):
    rel = s(path)
    return rel is not None and rel.startswith('legacy_api/handlers/') \
        and rel.endswith('.py')


def cover_handler(plan, tree, path):
    stem = Path(path).stem
    named = [] if stem == '__init__' else tree.named(
        [stem], dirs=('legacy_api/tests',))
    plan.add(path, 'handler', 'a legacy_api handler: the registry, event-leak '
             'and replay suites, and the legacy_api tests named after it',
             [*REGISTRY_CHECKS, *REPLAY_SUITES, *named])


def match_command(path):
    rel = s(path)
    return rel is not None and not in_tests(rel) and \
        re.fullmatch(r'\w+/management/commands/\w+\.py', rel) is not None and \
        Path(rel).stem != '__init__'


def cover_command(plan, tree, path):
    """A management command runs by name (`call_command("build_css")`), not
    by an import, so the import rule misses its tests, and
    tests/test_management_commands.py checks that a test names each one."""
    name = re.escape(Path(path).stem)
    named = re.compile(rf"[\"']{name}[\"']|commands(\.|\s+import\s+){name}\b")
    targets = [rel for rel in tree.test_files() if named.search(tree.text(rel))]
    if tree.exists(COMMANDS_GUARD):
        targets.append(COMMANDS_GUARD)
    plan.add(path, 'command', 'a management command: the tests that name it, as '
             f'{COMMANDS_GUARD} does', sorted(set(targets)))


def match_ui_python(path):
    rel = s(path)
    return rel is not None and rel.startswith('ui/') and rel.endswith('.py') \
        and not in_tests(rel) and 'migrations' not in Path(rel).parts \
        and not rel.startswith(SHARED_UI) and not rel.startswith('ui/management/')


def cover_ui_python(plan, tree, path):
    parts = Path(s(path)).parts
    key = parts[1] if len(parts) > 2 else Path(parts[1]).stem
    targets = tree.named(tokens_for(key))
    if not targets:
        plan.add(path, 'ui-python', f'ui code ("{key}"): no ui test is named '
                 'after it')
        return
    plan.add(path, 'ui-python', f'ui code ("{key}"): the ui and browser tests '
             'named after it, and the page-wide checks', [*targets, *PAGE_WIDE])


def match_app_python(path):
    rel = s(path)
    return rel is not None and rel.endswith('.py') and not in_tests(rel) \
        and app_of(rel) not in (None, 'ui') and not rel.startswith(
            ('legacy_api/handlers/', 'tools/')) and 'migrations' not in Path(rel).parts


def cover_app_python(plan, tree, path):
    rel = s(path)
    plan.add(path, 'app-python', 'app code: its nearest tests folder',
             [nearest_tests(tree, rel)])


def match_importers(path):
    rel = s(path)
    return rel is not None and rel.endswith('.py') and not in_tests(rel)


def cover_importers(plan, tree, path):
    tests, _ = tree.importers(module_name(s(path)))
    if tests:
        plan.add(path, 'importers', 'the tests that import it', tests)


def match_db_code(path):
    rel = s(path)
    return rel is not None and rel.endswith('.py')


# Write calls that are the ORM's by name, and those that are when they take no
# positional argument: `award.save()`, `qs.update(slug=...)`, not
# `book.save(out)` (openpyxl) or `params.update({...})`.
ORM_WRITES = {'bulk_create', 'bulk_update', 'get_or_create', 'update_or_create'}
ORM_KEYWORD_WRITES = {'save', 'create', 'update', 'delete'}


TEXT_IMPORT = re.compile(
    r'^\s*(?:from\s+([A-Za-z_][\w.]*)\s+import\s+([\w, ]+)|import\s+([A-Za-z_][\w.]*))',
    re.M)
TEXT_PATCH = re.compile(r'\b(?:patch|setattr|delattr)\(\s*[\'"]([A-Za-z_][\w.]*\.[\w.]+)[\'"]')


def text_imports(text):
    """The absolute imports and patch paths of a module ast cannot parse."""
    names = set()
    for m in TEXT_IMPORT.finditer(text):
        if m.group(3):
            names.add(m.group(3))
        else:
            mod = m.group(1)
            names.add(mod)
            names.update(f'{mod}.{a.strip()}' for a in m.group(2).split(',') if a.strip())
    names.update(TEXT_PATCH.findall(text))
    return names


def database_module(text):
    """Why a module is database code as a whole, or None: it imports a models
    module or django.db, makes an ORM write call, or runs raw SQL. Any edit to
    it then needs Postgres, whatever lines changed: #288's diff-line rule
    said "not needed" for a non-ORM edit to awards/editing.py or
    transfer/importer.py, which both write the database."""
    try:
        tree = ast.parse(text)
    except SyntaxError:
        # The server is Python 3.14 (`except A, B:` is 3.14 syntax), and a
        # runner's python3 can be older. A module this Python cannot read is
        # counted as database code, never passed over: plan-checks on 3.12
        # said "not needed" for awards/editing.py.
        return 'cannot be parsed by this Python, so counted as database code'
    for node in ast.walk(tree):
        names = []
        if isinstance(node, ast.Import):
            names = [a.name for a in node.names]
        elif isinstance(node, ast.ImportFrom):
            mod = node.module or ''
            names = [mod] + [f'{mod}.{a.name}' if mod else a.name for a in node.names]
        for name in names:
            parts = name.split('.')
            if 'models' in parts or parts[:2] == ['django', 'db']:
                return f'imports {name}'
        if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):
            attr = node.func.attr
            if attr in ORM_WRITES or (attr in ORM_KEYWORD_WRITES and not node.args):
                return f'calls .{attr}()'
    hit = RAW_SQL.search(text)
    return f'raw SQL ({hit.group(0)!r})' if hit else None


def cover_db_code(plan, tree, path):
    rel = s(path)
    if not in_tests(rel):
        why = database_module(tree.text(rel))
        if why:
            plan.postgres.append(f'{path}: database code, as a whole module ({why})')
            return
    pattern = RAW_SQL if in_tests(rel) else DB_CODE
    text = diff_text(plan, path) if plan.from_git else tree.text(rel)
    hit = pattern.search(text)
    if not hit and not in_tests(rel) and DJANGO_IMPORT.search(tree.text(rel)):
        hit = QUERYSET.search(text)
    if hit:
        plan.postgres.append(f'{path}: database code ({hit.group(0)!r})')


def match_shared_ui(path):
    rel = s(path)
    return rel is not None and rel.startswith(SHARED_UI)


def cover_shared_ui(plan, tree, path):
    plan.command('python3 -I ui/css_build.py check')
    plan.add(path, 'shared-ui', 'a file every page loads: the whole browser '
             'suite and the page-wide checks', [BROWSER_DIR, *PAGE_WIDE])


def match_ui_page(path):
    rel = s(path)
    return rel is not None and not rel.startswith(SHARED_UI) and (
        '/templates/' in f'/{rel}' or '/static/' in f'/{rel}')


def cover_ui_page(plan, tree, path):
    rel = s(path)
    unique = []
    if '/templates/' in f'/{rel}':
        name = template_name(rel)
        pages = tree.pages_using('template', name) | {name}
        unique = [name]
        plan.command('python3 -I ui/css_build.py check')
    else:
        name = static_name(rel)
        pages = tree.pages_using('static', name)
        # A file loaded only on pages that load this one counts as this one:
        # a test that names it opens one of them. test_table_columns.py names
        # kiosk-ondeck.js, which loads only on pages that load kiosk.css.
        refs = {name}
        for _, uses in tree.graph().values():
            for kind, ref in uses:
                others = tree.pages_using('static', ref) if kind == 'static' else ()
                if others and others <= pages:
                    refs.add(ref)
        for ref in refs:
            unique.append(ref)
            # A bare name counts only where PHP has no file of that name, since
            # tests cite PHP's ondeck.css and now-racing.js.
            if Path(ref).name not in tree.website_names():
                unique.append(Path(ref).name)
    keys = set()
    for page in pages | {name}:
        first = page.split('/')
        if first[0] == 'ui' and len(first) > 2:
            keys.add(first[1])
        elif first[0] == 'ui' and len(first) == 2:
            keys.add(re.split(r'[-_.]', first[1])[0] if not first[1].endswith(
                '.html') else Path(first[1]).stem)
        elif first[0] == 'timer':
            keys.add('timer')
        else:
            keys.add(first[0])
    tokens = sorted({t for k in keys for t in tokens_for(k)})
    targets = tree.named(tokens) + tree.mentions(sorted(set(unique)))
    if app_of(rel) != 'ui':
        targets.append(nearest_tests(tree, rel))
    note = (f'a page\'s template or static file ({", ".join(sorted(keys))}): the '
            'ui and browser tests named after the pages that load it, and the '
            'tests that name it')
    if '/templates/' in f'/{rel}':
        note += ', and the page-wide checks'
        targets += PAGE_WIDE
    if targets:
        plan.add(path, 'ui-page', note, sorted(set(targets)))


ROLE_PAGES = 'tests/test_role_pages_fixture.py'


def role_page_views(tree):
    """The modules of the views `OTHER_PAGES` in the role-pages check names
    (`"ui.timer.views.browser_timer"` is ui/timer/views.py), read from its
    source so a row added there maps too."""
    try:
        module = ast.parse(tree.text(ROLE_PAGES))
    except SyntaxError:
        return []
    found = []
    for node in module.body:
        target = node.target if isinstance(node, ast.AnnAssign) else (
            node.targets[0] if isinstance(node, ast.Assign) else None)
        if not (isinstance(target, ast.Name) and target.id == 'OTHER_PAGES'
                and isinstance(node.value, ast.Dict)):
            continue
        for value in node.value.values:
            first = value.elts[0] if isinstance(value, ast.Tuple) and value.elts else None
            if isinstance(first, ast.Constant) and isinstance(first.value, str):
                parts = first.value.split('.')[:-1]
                for rel in ('/'.join(parts) + '.py', '/'.join(parts) + '/__init__.py'):
                    if tree.exists(rel) and rel not in found:
                        found.append(rel)
    return found


def match_role_gates(path):
    rel = s(path)
    return rel is not None and not in_tests(rel) and rel.endswith('.py')


def cover_role_gates(plan, tree, path):
    """test_role_pages_fixture.py holds the shell suite's page lists to each
    old page's gate before a push; only CI runs that suite, and #323's CI
    failed 10 jobs on the fixture (#320 retro). The fixtures, the seeded
    roles and the gates reach it by name or import; this adds the URL confs
    its resolve() reads and the views its OTHER_PAGES names, whose gates it
    holds by hand."""
    rel = s(path)
    if Path(rel).name != 'urls.py' and rel not in role_page_views(tree):
        return
    if Path(rel).name == 'urls.py':
        note = ('a URL conf: the role-pages check resolves each old page '
                'Django answers itself through it')
    else:
        note = ('answers an old page whose gate the role-pages check holds by '
                'hand in OTHER_PAGES: a change to its check changes that row, and '
                'the page\'s list in testing/fixtures/role-pages-django.json; only '
                'CI\'s shell suite (testing/test-permissions.sh) checks the replies')
    plan.add(path, 'role-gates', note, [ROLE_PAGES])


def match_server_tools(path):
    rel = s(path)
    return rel is not None and rel.startswith('tools/')


def cover_server_tools(plan, tree, path):
    rel = s(path)
    if rel == 'tools/pytest-postgres.sh':
        plan.postgres.append(f'{path}: the Postgres runner itself')
    # A tool in a package, such as tools/standings_differential/, is named and
    # imported as the package (an import's text names it too): its
    # __main__.py has no test of its own.
    stems = [Path(rel).stem]
    if len(Path(rel).parts) > 2:
        stems.append(Path(rel).parts[1])
    words = [Path(rel).name] + [f'tools{sep}{stem}' for stem in stems for sep in './']
    targets = tree.mentions(words)
    if rel.endswith('.py'):
        targets += tree.importers(module_name(rel))[0]
    if not targets:
        plan.add(path, 'server-tools', 'a server tool no test names or imports: no '
                 'pytest target. Run it by hand on the change')
        return
    plan.add(path, 'server-tools', 'a server tool: the tests that name or import it',
             sorted(set(targets)))


def match_docker(path):
    return path.startswith(f'{SERVER}/docker/') or path == '.github/workflows/image.yml'


def cover_docker(plan, tree, path):
    """No pytest runs the image. #58 pushed its first image.yml unrun, and
    two of its steps failed CI on a guess (a stand-in image built from the
    wrong tree, a log check that missed a URL prefix); its round 1 checks
    ran only by hand (#58 retro)."""
    # A prefix and tag of its own: checks.sh removes every container, volume
    # and network under its prefix, so two runs that share one remove each
    # other's (CLAUDE.md; #58 retro review).  The status is checks.sh's.
    plan.command('P=derbynet-checks-$$ && '
                 'docker build -f docker/Dockerfile -t "derbynet_server:$P" .. && '
                 'IMAGE="derbynet_server:$P" DERBYNET_TEST_PREFIX="$P" docker/ci/checks.sh; '
                 's=$?; docker rmi "derbynet_server:$P" >/dev/null; (exit $s)')
    plan.add(path, 'docker', 'the Docker image (#58): build it and run checks.sh '
             '(its header lists the checks; backup and upgrade run by name), then '
             'each image.yml step the diff changes, by hand against that image. '
             'The tests that name the file:',
             tree.mentions([Path(path).name, 'checks.sh' if path.endswith('.yml') else '']))


RULES = (
    ('everything', match_everything, cover_everything),
    ('guide', match_guide, cover_guide),
    ('docs', match_docs, cover_docs),
    ('website', match_website, cover_website),
    ('plan-tools', match_plan_tools, cover_plan_tools),
    ('timer-build', match_timer_build, cover_timer_build),
    ('testing', match_testing, cover_testing),
    ('test-file', match_test_file, cover_test_file),
    ('test-helper', match_test_helper, cover_test_helper),
    ('test-data', match_test_data, cover_test_data),
    ('model', match_model, cover_model),
    ('service', match_service, cover_service),
    ('handler', match_handler, cover_handler),
    ('command', match_command, cover_command),
    ('ui-python', match_ui_python, cover_ui_python),
    ('app-python', match_app_python, cover_app_python),
    ('importers', match_importers, cover_importers),
    ('db-code', match_db_code, cover_db_code),
    ('shared-ui', match_shared_ui, cover_shared_ui),
    ('ui-page', match_ui_page, cover_ui_page),
    ('role-gates', match_role_gates, cover_role_gates),
    ('server-tools', match_server_tools, cover_server_tools),
    ('docker', match_docker, cover_docker),
)


def fallback(plan, tree, path):
    rel = s(path)
    if rel is None:
        why = 'no rule maps it and it is outside server/: CI\'s full run covers it'
        plan.everything.append(f'{path}: {why}')
        plan.add(path, 'fallback', why)
        return
    app = app_of(rel)
    if app is None or not (tree.server / app).is_dir():
        targets = ['tests']
        where = 'server/tests'
    else:
        targets = tree.test_dirs_under(app) or [nearest_tests(tree, rel)]
        where = f"{app}'s tests"
    plan.add(path, 'fallback', f'no rule maps it to a test: {where}, the app it '
             'is in', targets)


def map_file(plan, tree, path):
    rel = s(path)
    if rel and not in_tests(rel) and Path(rel).suffix in MUTANT_SOURCES \
            and not NOT_HAND_WRITTEN & set(Path(rel).parts) and tree.exists(rel):
        plan.changed_source.append(rel)
    for _name, matches, cover in RULES:
        if matches(path):
            cover(plan, tree, path)
    entries = plan.covers.get(path, [])
    if not any(targets or rule in ('everything', 'docs', 'website', 'plan-tools', 'docker')
               or note.startswith('a server tool no test')
               or note.startswith('deleted')
               for rule, note, targets in entries):
        fallback(plan, tree, path)


# --- git -------------------------------------------------------------------

def git(root, *argv):
    return subprocess.run(['git', *argv], cwd=root, check=True,
                          capture_output=True, text=True).stdout


def changed_files(plan):
    root, base = plan.root, plan.base
    files = git(root, 'diff', '--name-only', f'{base}...HEAD').splitlines()
    files += git(root, 'diff', '--name-only', 'HEAD').splitlines()
    plan.untracked = git(root, 'ls-files', '--others', '--exclude-standard').splitlines()
    return list(dict.fromkeys(files + plan.untracked))


def diff_text(plan, path):
    """The lines the branch and the working tree add or remove in `path`; an
    untracked file's whole text."""
    if path in plan.untracked:
        return (plan.root / path).read_text(errors='replace')
    out = git(plan.root, 'diff', '-U0', f'{plan.base}...HEAD', '--', path)
    out += git(plan.root, 'diff', '-U0', 'HEAD', '--', path)
    return '\n'.join(ln[1:] for ln in out.splitlines()
                     if ln[:1] in '+-' and not ln.startswith(('+++', '---')))


def base_text(plan, rel):
    """`server/rel` as it was where the branch left BASE (the diff is
    BASE...HEAD), or None when it is new on the branch."""
    if plan.merge_base is None:
        plan.merge_base = git(plan.root, 'merge-base', plan.base, 'HEAD').strip()
    try:
        return git(plan.root, 'show', f'{plan.merge_base}:{SERVER}/{rel}')
    except subprocess.CalledProcessError:
        return None


# --- D97: an import-only move ----------------------------------------------
#
# A browser test file whose diff only moves top-level code, unchanged, into a
# module it imports takes no repeats under load (D97, amending D85; #313's
# helper move cost 156 min of them). A wrong verdict skips the repeats that
# would show a flake, so every check fails closed: what can't be parsed or
# resolved keeps the repeats (#320's Risks).

class NotImportOnly(Exception):
    """Why a file keeps its repeats."""


AMBIGUOUS = object()  # a name bound twice, or by a loop, a try, `global`...
# Names pytest or Python read from the module itself: moved, they change
# what runs, so a file that deletes one keeps its repeats.
SPECIAL = re.compile(r'__\w+__|pytestmark|pytest_\w+|test\w*|Test\w*')
DUNDER = re.compile(r'__\w+__')


def is_import(node):
    return isinstance(node, (ast.Import, ast.ImportFrom))


def defined_name(node):
    """The one name a top-level def, class or simple assignment binds, or None."""
    if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
        return node.name
    if isinstance(node, ast.Assign) and len(node.targets) == 1 \
            and isinstance(node.targets[0], ast.Name):
        return node.targets[0].id
    if isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name) \
            and node.value is not None:
        return node.target.id
    return None


def stored_names(node):
    """Every name a statement may bind, wherever in it."""
    out = set()
    for n in ast.walk(node):
        if isinstance(n, ast.Name) and not isinstance(n.ctx, ast.Load):
            out.add(n.id)
        elif isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            out.add(n.name)
        elif isinstance(n, (ast.Import, ast.ImportFrom)):
            out.update((a.asname or a.name).split('.')[0] for a in n.names)
        elif isinstance(n, ast.ExceptHandler) and n.name:
            out.add(n.name)
        elif isinstance(n, (ast.MatchAs, ast.MatchStar)) and n.name:
            out.add(n.name)
        elif isinstance(n, ast.MatchMapping) and n.rest:
            out.add(n.rest)
    return out


def bindings(module, where):
    """name -> what binds it at module level: ('from', module, name), or
    ('import', {modules}) for `import a.b` (which binds `a`), or the
    statement of a def, class or simple assignment; AMBIGUOUS for a name bound
    twice or otherwise. A relative or star import fails: it can't be
    resolved."""
    out = {}

    def bind(name, what):
        old = out.get(name)
        if old is None:
            out[name] = what
        elif isinstance(old, tuple) and isinstance(what, tuple) \
                and old[0] == what[0] == 'import':
            out[name] = ('import', old[1] | what[1])
        else:
            out[name] = AMBIGUOUS

    for node in module.body:
        if isinstance(node, ast.ImportFrom):
            if node.level:
                raise NotImportOnly(f'{where} line {node.lineno}: a relative import')
            for a in node.names:
                if a.name == '*':
                    raise NotImportOnly(f'{where} line {node.lineno}: a star import')
                bind(a.asname or a.name, ('from', node.module, a.name))
        elif isinstance(node, ast.Import):
            for a in node.names:
                if a.asname:
                    bind(a.asname, ('from', a.name, None))
                else:
                    bind(a.name.split('.')[0], ('import', frozenset([a.name])))
        elif defined_name(node):
            bind(defined_name(node), node)
        else:
            for name in stored_names(node):
                out[name] = AMBIGUOUS
    for node in ast.walk(module):
        if isinstance(node, (ast.Global, ast.Nonlocal)):
            for name in node.names:
                out[name] = AMBIGUOUS
    return out


def lookup(binds, name, where):
    found = binds.get(name)
    if found is AMBIGUOUS:
        raise NotImportOnly(f'{where} binds {name} more than once, or not by a '
                            'plain def, assignment or import')
    return found


def mentions(module):
    """The names a module reads: each Name, parameter, and string constant
    that is a bare name (a fixture's name in `usefixtures` or
    `getfixturevalue`)."""
    out = set()
    for n in ast.walk(module):
        if isinstance(n, ast.Name):
            out.add(n.id)
        elif isinstance(n, ast.arg):
            out.add(n.arg)
        elif isinstance(n, ast.Constant) and isinstance(n.value, str) \
                and n.value.isidentifier():
            out.add(n.value)
    return out


def comments(text, skip_lines=()):
    """The comments of `text`, in order, outside the lines in `skip_lines`."""
    try:
        tokens = list(tokenize.generate_tokens(io.StringIO(text).readline))
    except (tokenize.TokenError, SyntaxError) as e:
        raise NotImportOnly(f'cannot be tokenized ({e})') from None
    return [t.string.strip() for t in tokens
            if t.type == tokenize.COMMENT and t.start[0] not in skip_lines]


def import_only(base_text, head_text, module_text):
    """D97's verdict on a browser test file: {module: [moved names]} when the
    diff from `base_text` to `head_text` only changes imports and deletes
    top-level definitions that a module it imports from (`module_text(name)`
    gives its text, or None outside the tree) has unchanged: each imported
    by name from it, or a dependency of one that nothing the file keeps
    reads and that is not decorated. Raises NotImportOnly with the reason
    otherwise."""
    if base_text is None:
        raise NotImportOnly('new on the branch')
    try:
        base = ast.parse(base_text)
        head = ast.parse(head_text)
    except SyntaxError as e:
        raise NotImportOnly(f'cannot be parsed ({e.msg}, line {e.lineno})') from None
    return moves(base, head, module_text, (base_text, head_text))


def moves(base, head, module_text, texts=None):
    """import_only() on parsed modules; `texts`, the two files' texts, adds
    the check that no comment is new. D101 calls it on the files with their
    changed tests and helpers put back as BASE had them."""
    base_binds = bindings(base, 'BASE')
    head_binds = bindings(head, 'the file')

    # Everything but the imports is BASE's, in order, less what was deleted.
    kept = [n for n in base.body if not is_import(n)]
    deleted, i = [], 0
    for node in (n for n in head.body if not is_import(n)):
        dump = ast.dump(node)
        while i < len(kept) and ast.dump(kept[i]) != dump:
            deleted.append(kept[i])
            i += 1
        if i == len(kept):
            raise NotImportOnly(f'line {node.lineno} is new or changed')
        i += 1
    deleted += kept[i:]
    if not deleted:
        raise NotImportOnly('it moves no top-level definition')

    # A comment is no code, but it is a change to the file.
    if texts is not None:
        import_lines = {ln for n in head.body if is_import(n)
                        for ln in range(n.lineno, n.end_lineno + 1)}
        old = iter(comments(texts[0]))
        for comment in comments(texts[1], import_lines):
            if not any(comment == c for c in old):
                raise NotImportOnly(f'a comment is new or changed: {comment}')

    for tree, where in ((base, 'BASE'), (head, 'the file')):
        no_walrus(tree, where)

    modules = {}

    def parsed(name):
        if name not in modules:
            text = module_text(name)
            if text is None:
                modules[name] = None
            else:
                try:
                    tree = ast.parse(text)
                except SyntaxError as e:
                    raise NotImportOnly(f'{name} cannot be parsed ({e.msg}, '
                                        f'line {e.lineno})') from None
                no_walrus(tree, name)
                modules[name] = (tree, bindings(tree, name))
        return modules[name]

    deleted_ids = {id(n) for n in deleted}
    reached = {}  # a deleted name a moved def reads -> the module both are in

    def same(name, node, module, seen):
        """`module` has `name` as BASE's `node`, and each name it reads is
        bound alike in both modules. A name it reads that the file binds by a
        statement must be deleted from the file too (#320 review, H2): kept,
        the file and `module` would each have their own, such as a list."""
        if (module, name) in seen:
            return
        seen.add((module, name))
        copy = lookup(parsed(module)[1], name, module)
        if not isinstance(copy, ast.stmt) or ast.dump(copy) != ast.dump(node):
            raise NotImportOnly(f'{module} has {name} otherwise than the file had it')
        for read in sorted({n.id for n in ast.walk(node) if isinstance(n, ast.Name)}):
            if read == name:
                continue
            ours = lookup(base_binds, read, 'BASE')
            theirs = lookup(parsed(module)[1], read, module)
            if ours is None and theirs is None and not DUNDER.fullmatch(read):
                continue  # a local or a builtin in both
            if isinstance(ours, tuple) and ours == theirs:
                continue
            if isinstance(ours, ast.stmt) and isinstance(theirs, ast.stmt):
                if id(ours) not in deleted_ids:
                    raise NotImportOnly(f'{name} reads {read}, which the file keeps, '
                                        f'so the file and {module} would each have one')
                reached.setdefault(read, module)
                same(read, ours, module, seen)
                continue
            raise NotImportOnly(f'{name} reads {read}, which {module} binds '
                                'otherwise than the file did')

    used = mentions(head)
    # The names first, then the imported ones, then the rest, so that the
    # reason given is the most telling one.
    names = {}
    for node in deleted:
        name = defined_name(node)
        if name is None:
            raise NotImportOnly(f'it deletes line {node.lineno}, which is not a def, '
                                'a class or a constant')
        if SPECIAL.fullmatch(name):
            raise NotImportOnly(f'it deletes {name}, which pytest or Python reads '
                                'from the file itself')
        names[name] = node
    moved = {}  # name -> the module that has it now
    seen = set()
    for name, node in names.items():
        bound = lookup(head_binds, name, 'the file')
        if bound is None:
            continue
        if isinstance(bound, ast.stmt):
            raise NotImportOnly(f'the file still defines {name}')
        if not (bound[0] == 'from' and bound[2] == name):
            raise NotImportOnly(f'{name} is imported, but not as `from M import {name}`')
        if parsed(bound[1]) is None:
            raise NotImportOnly(f'{name} comes from {bound[1]}, which is not in '
                                'the tree')
        same(name, node, bound[1], seen)
        moved[name] = bound[1]
    # A deleted name the file doesn't import is a dependency the moved code
    # took along (#313's BOUND, read only by bound): the moved code reads it,
    # and nothing the file keeps does. pytest reads a fixture or a hook by
    # its presence in the file, so a decorated def, or a constant built by a
    # call (`pytest.fixture(...)(f)`), is imported by name or keeps the
    # repeats (#320 review, H1).
    for name in names:
        if name not in moved and name in used:
            raise NotImportOnly(f'{name} is deleted and still used, but not imported')
    for name, node in names.items():
        if name in moved:
            continue
        if name not in reached:
            raise NotImportOnly(f'it deletes {name}, which it neither imports by name '
                                'nor moves with code it imports')
        if getattr(node, 'decorator_list', None):
            raise NotImportOnly(f'{name} moves with code that reads it, but is '
                                'decorated: import it by name')
        if isinstance(node, (ast.Assign, ast.AnnAssign)) \
                and any(isinstance(n, ast.Call) for n in ast.walk(node.value)):
            raise NotImportOnly(f'{name} moves with code that reads it, but is built '
                                'by a call: import it by name')
        moved[name] = reached[name]
    for module in sorted(set(moved.values())):
        if futures(base) != futures(parsed(module)[0]):
            raise NotImportOnly(f'the file and {module} differ in their '
                                '`from __future__` imports')

    # The imports: one that binds a name anew binds a moved definition, and
    # one that goes left with the moved code that read it, and that alone
    # (#320 review, H3): an import read by nothing may be there for its
    # effect, such as an autouse fixture or a plugin module.
    head_imported, base_imported = imported(head), imported(base)
    for name in sorted(head_imported - set(moved)):
        bound = lookup(head_binds, name, 'the file')
        if name not in base_binds:
            raise NotImportOnly(f'it imports {name}, which is no moved definition')
        if lookup(base_binds, name, 'BASE') != bound:
            raise NotImportOnly(f'it imports {name} otherwise than BASE did')
    moved_reads = set().union(*(mentions(n) for n in deleted))
    for name in sorted(base_imported - head_imported):
        if name in used:
            raise NotImportOnly(f'{name} is no longer imported but still used')
        if name not in moved_reads:
            raise NotImportOnly(f'it drops the import of {name}, which no moved code '
                                'read: an import can matter by itself')
    by_module = {}
    for name in names:  # in BASE's order
        by_module.setdefault(moved[name], []).append(name)
    return by_module


def no_walrus(tree, where):
    """Fails on an assignment expression evaluated at module level, which
    binds a module name that `bindings()` doesn't see (#320 review, H4): in
    a statement, a comprehension, a default or a decorator, but not in a
    function's or a lambda's body. Python refuses one in an annotation."""
    stack = list(tree.body)
    while stack:
        n = stack.pop()
        if isinstance(n, ast.NamedExpr):
            raise NotImportOnly(f'{where} line {n.lineno}: an assignment expression '
                                '(:=) outside a function')
        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)):
            stack += [*n.decorator_list, n.args]
        elif isinstance(n, ast.Lambda):
            stack.append(n.args)
        else:
            stack.extend(ast.iter_child_nodes(n))


def futures(tree):
    """The `from __future__` features a module turns on."""
    return {a.name for n in tree.body if isinstance(n, ast.ImportFrom)
            and n.module == '__future__' for a in n.names}


def imported(module):
    """The names a module's top-level imports bind."""
    return {(a.asname or a.name).split('.')[0]
            for n in module.body if is_import(n) for a in n.names}


def module_text(tree, name):
    """The working tree's text of module `name`, or None when no file of
    server/ holds it."""
    rel = name.replace('.', '/')
    for path in (f'{rel}.py', f'{rel}/__init__.py'):
        if tree.exists(path):
            return tree.text(path)
    return None


# --- D101: the tests a diff adds or changes ---------------------------------
#
# A changed browser test file repeats under load only the tests its diff adds
# or changes, by node id, and the tests that reach a helper it adds or
# changes (D101, amending D85 beside D97; #319's 25 repeats of all of
# test_timer.py took 58 min for one new test and a helper drawn out of
# another). As with D97, a wrong verdict skips repeats that would show a
# flake, so every check fails closed: whatever else the diff changes, or the
# tool can't resolve, repeats the whole file.

class WholeFile(Exception):
    """Why a file repeats whole."""


FUNCTIONS = (ast.FunctionDef, ast.AsyncFunctionDef)
# The xunit-style setups and teardowns pytest 9.2 calls by name, at module
# and class level (`_pytest/python.py`, `_get_first_non_fixture_func`):
# server/tests/test_xunit_names.py sweeps them from a pytest run (#336
# review, M1).
XUNIT = ('setUpModule', 'setup_module', 'tearDownModule', 'teardown_module',
         'setup_function', 'teardown_function', 'setup_class', 'teardown_class',
         'setup_method', 'teardown_method')
# What pytest or Python reads from a module or a class by its presence: a
# hook, an xunit setup or teardown (#336), pytestmark, a dunder.
PYTEST_READS = re.compile(r'__\w+__|pytestmark|pytest_\w+|' + '|'.join(XUNIT))


def marks_only(node):
    """Each decorator of `node` is `pytest.mark.X` or a call of one, such as
    `pytest.mark.parametrize(...)`: a test's own marks. A fixture or any
    other decorator makes it no test this verdict can resolve."""
    for d in node.decorator_list:
        if isinstance(d, ast.Call):
            d = d.func
        if not (isinstance(d, ast.Attribute) and isinstance(d.value, ast.Attribute)
                and d.value.attr == 'mark' and isinstance(d.value.value, ast.Name)
                and d.value.value.id == 'pytest'):
            return False
    return True


def is_docstring(node):
    return isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant) \
        and isinstance(node.value.value, str)


def is_test(node):
    """A def pytest collects as a test (python_functions' default, `test`),
    with only marks for decorators."""
    return isinstance(node, FUNCTIONS) and node.name.startswith('test') \
        and marks_only(node)


def is_helper(node):
    """A module-level def that is no fixture or other decorated def, and
    nothing pytest reads by its name. Side reads a test first."""
    return isinstance(node, FUNCTIONS) and not node.decorator_list \
        and not PYTEST_READS.fullmatch(node.name)


def is_test_class(node):
    """A class pytest collects (python_classes' default, `Test`, and no
    `__init__`)."""
    return isinstance(node, ast.ClassDef) and node.name.startswith('Test') \
        and not any(isinstance(n, FUNCTIONS) and n.name == '__init__'
                    for n in node.body)


def what(node):
    """How the output names a statement of a file's frame."""
    if isinstance(node, FUNCTIONS):
        if PYTEST_READS.fullmatch(node.name):
            return f'the hook {node.name}'
        if any('fixture' in mentions(d) or any(isinstance(n, ast.Attribute)
                                                and n.attr == 'fixture'
                                                for n in ast.walk(d))
               for d in node.decorator_list):
            return f'the fixture {node.name}'
        return f'the decorated def {node.name}'
    if isinstance(node, ast.ClassDef):
        return f'the class {node.name}'
    if is_import(node):
        return f'the import on line {node.lineno}'
    name = defined_name(node)
    if name:
        return f'the module-level {name}'
    return f'the module-level code on line {node.lineno}'


class Side:
    """One side of the diff, BASE or HEAD, cut into what D101 resolves (the
    tests, the helpers, the test classes and their test methods) and the
    frame, which must be the same at both."""

    def __init__(self, module, where):
        self.module = module
        body = list(module.body)
        self.doc = None
        if body and is_docstring(body[0]):
            self.doc = body.pop(0).value.value
        self.tests, self.helpers, self.classes, self.frame = {}, {}, {}, []
        for node in body:
            if is_test(node):
                self.tests[node.name] = node
            elif is_helper(node):
                self.helpers[node.name] = node
            elif is_test_class(node):
                self.classes[node.name] = TestClass(node, where)
            else:
                self.frame.append(node)
        try:
            binds = bindings(module, where)
        except NotImportOnly as e:
            raise WholeFile(str(e)) from None
        for name in [*self.tests, *self.helpers, *self.classes]:
            if binds.get(name) is AMBIGUOUS:
                raise WholeFile(f'{where} binds {name} more than once, or not by a '
                                'plain def')

    def names(self):
        return {**self.tests, **self.helpers,
                **{name: c.node for name, c in self.classes.items()}}


class TestClass:
    """A test class: its test methods, and the class less them and its
    docstring, which must be the same at BASE and HEAD."""

    def __init__(self, node, where):
        self.node = node
        body = list(node.body)
        self.doc = body.pop(0).value.value if body and is_docstring(body[0]) else None
        self.tests = {}
        rest = []
        for n in body:
            if is_test(n):
                if n.name in self.tests:
                    raise WholeFile(f'{where} defines {node.name}.{n.name} twice')
                self.tests[n.name] = n
            else:
                rest.append(n)
        self.frame = ast.ClassDef(name=node.name, bases=node.bases,
                                  keywords=node.keywords, body=rest,
                                  decorator_list=node.decorator_list,
                                  type_params=node.type_params)
        self.rest = rest


def attributes(node, owners):
    """The attributes `node` reads off a name in `owners`, such as
    `self.test_b` (#336 review, L2: mentions() reads no attribute)."""
    return {n.attr for n in ast.walk(node) if isinstance(n, ast.Attribute)
            and isinstance(n.value, ast.Name) and n.value.id in owners}


def reads_doc(module):
    """The module reads a `__doc__`, its own or a class's."""
    return any((isinstance(n, ast.Name) and n.id == '__doc__')
               or (isinstance(n, ast.Attribute) and n.attr == '__doc__')
               or (isinstance(n, ast.Constant) and n.value == '__doc__')
               for n in ast.walk(module))


def frame_change(base, head):
    """How the module-level frame differs, or None."""
    old = [ast.dump(n) for n in base.frame]
    new = [ast.dump(n) for n in head.frame]
    if old == new:
        return None
    for node, dump in zip(head.frame, new):
        if dump not in old:
            return f'{what(node)} is new or changed'
    for node, dump in zip(base.frame, old):
        if dump not in new:
            return f'it deletes {what(node)}'
    return 'it reorders the module-level code'


def frame_names(node):
    """The names a statement of the frame binds: the one a def, class or
    simple assignment defines, else every name it may bind."""
    name = defined_name(node)
    return {name} if name else stored_names(node)


def frame_seeds(base, head):
    """For changed_tests(claims=True): the names the frame binds otherwise
    at HEAD than at BASE. A new, changed or deleted import seeds each name
    it binds whose binding differs, or that is bound twice, so a test
    reading a name the import bound before is no reader; any other such
    statement seeds the one name it defines (a fixture, a constant), or
    every name it may bind."""
    binds = bindings(base.module, 'BASE'), bindings(head.module, 'the file')
    old = [ast.dump(n) for n in base.frame]
    new = [ast.dump(n) for n in head.frame]
    changed = [n for n, d in zip(head.frame, new) if d not in old]
    changed += [n for n, d in zip(base.frame, old) if d not in new]
    out = set()
    for node in changed:
        if not frame_names(node):
            # `CASES.append(2)` changes what a name holds without binding
            # it, and no reader can be found by name (#379 review).
            raise WholeFile(f'{what(node)} changes and binds nothing')
        for name in frame_names(node):
            was, now = (b.get(name) for b in binds)
            # A def or an assignment binds its own node, which differs
            # between the two parses: only an import's binding can be equal.
            if was is AMBIGUOUS or was != now:
                out.add(name)
    return out


def autouse(module):
    """The module-level fixtures pytest applies to each test without its
    asking: `autouse=` anything but a literal False."""
    out = set()
    for node in module.body:
        for d in getattr(node, 'decorator_list', []):
            if isinstance(d, ast.Call) and 'fixture' in mentions(d.func) | attributes(
                    d.func, {'pytest'}) and any(
                    k.arg == 'autouse' and not (isinstance(k.value, ast.Constant)
                                                and k.value.value is False)
                    for k in d.keywords):
                out.add(node.name)
    return out


def claims_readers(head, reached):
    """For changed_tests(claims=True): [(name, why)] for each top-level test
    D101 holds in the frame (a test with another decorator than a mark) and
    each class that holds a test, however it is named, or subclasses one,
    that reads a reached name anywhere in it (its decorators, bases, class
    attributes, fixture methods, mixins), or is reached; a subclass of a
    named class is named too (#379 review). A helper or frame name that
    reads a named class passes it on to the tests that read it. A reached
    hook, xunit setup, pytestmark or autouse fixture, which pytest applies
    to every test it covers, raises WholeFile: every claim counts."""
    hit = sorted(n for n in reached if PYTEST_READS.fullmatch(n)
                 or n in autouse(head.module))
    if hit:
        raise WholeFile(f'{hit[0]}, which pytest applies to each test it covers, '
                        'changes or reads a change')
    classes = [n for n in head.module.body if isinstance(n, ast.ClassDef)]
    holding = {c.name for c in classes
               if any(isinstance(n, FUNCTIONS) and n.name.startswith('test')
                      for n in c.body)}
    for _ in range(len(classes)):
        holding |= {c.name for c in classes if mentions(ast.Module(body=c.bases,
                                                                    type_ignores=[]))
                    & holding}
    found = {}
    reached = set(reached)
    # A helper or frame name that reads a class named here passes it on, as
    # changed_tests() passes on a seed: a helper that calls
    # `TestK().again1()` (#374 retro, ReachShapes' claims oracle).
    others = {**head.helpers}
    others.update({name: node for node in head.frame
                   for name in frame_names(node)})
    # Each pass adds a name or stops, so the bound is only a cap.
    for _ in range(len(head.module.body) + len(others) + 1):
        grown = False
        for name, node in others.items():
            if name not in reached and mentions(node) & reached:
                reached.add(name)
                grown = True
        for node in head.module.body:
            name = getattr(node, 'name', None)
            if name in found or not (
                    isinstance(node, FUNCTIONS) and name.startswith('test')
                    or name in holding):
                continue
            read = mentions(node) & (reached - {name})
            if name in reached or read:
                found[name] = f'reads {", ".join(sorted(read))}' if read else 'reached'
                reached.add(name)
                grown = True
        if not grown:
            break
    return [(n.name, found[n.name]) for n in head.module.body
            if getattr(n, 'name', None) in found]


def put_back(base, head):
    """The two modules for D97's check of the frame: each test, helper and
    test class HEAD has put back as BASE had it, one HEAD adds left out, a
    test or test class HEAD deletes left out of BASE, and neither docstring.
    A deleted helper stays in BASE, for D97 to find moved or not."""
    old = base.names()
    units = {id(n) for n in head.names().values()}
    head_body = []
    for n in head.module.body:
        if id(n) not in units:
            head_body.append(n)
        elif n.name in old:
            head_body.append(old[n.name])
    gone = {id(n) for name, n in old.items()
            if name not in head.names() and name not in base.helpers}
    base_body = [n for n in base.module.body if id(n) not in gone]
    for body, side in ((base_body, base), (head_body, head)):
        if side.doc is not None:
            del body[0]
    return (ast.Module(body=base_body, type_ignores=[]),
            ast.Module(body=head_body, type_ignores=[]))


def changed_tests(base_text, head_text, module_text, claims=False):
    """D101's verdict on a browser test file: [(node id less the path, why)],
    in HEAD's order, for each test the diff from `base_text` to `head_text`
    adds or changes, by AST, and each that reads, directly or through a
    helper of the file, a helper the diff adds, changes or deletes. A frame
    that differs is resolved only as a D97 move (`module_text` as for
    import_only()). Raises WholeFile with the reason otherwise.

    With `claims`, for `tools/docstring_claims.py --check --base` (D123,
    #374): a changed frame is no reason to repeat the whole file, since an
    import or a constant changes no claim of a test that never reads it.
    Each name a new, changed or deleted frame statement binds otherwise, a
    fixture's or an import's, is a seed instead, as a helper is, and so is
    a test class that changes outside its test methods, and a frame
    statement that reads a seed passes it on to the tests that read the
    name it binds; a changed helper nothing in the file reads, or a diff
    that changes no test, gives no reason either, and the list may be
    empty. claims_readers() then names each top-level test or test-holding
    class that reads a reached name outside what D101 resolves. What can't
    be parsed or resolved still raises, and so does a changed frame
    statement that binds nothing, or a reached hook, pytestmark or autouse
    fixture (#379 review)."""
    if base_text is None:
        raise WholeFile('new on the branch, so each of its tests is new')
    try:
        trees = ast.parse(base_text), ast.parse(head_text)
    except SyntaxError as e:
        raise WholeFile(f'cannot be parsed ({e.msg}, line {e.lineno})') from None
    for tree, where in zip(trees, ('BASE', 'the file')):
        try:
            no_walrus(tree, where)
        except NotImportOnly as e:
            raise WholeFile(str(e)) from None
        for n in ast.walk(tree):
            if isinstance(n, ast.Global):
                raise WholeFile(f'{where} line {n.lineno}: `global` lets a def rebind '
                                'a module name')
    base, head = Side(trees[0], 'BASE'), Side(trees[1], 'the file')

    docs = [(base.doc, head.doc)] + [(c.doc, head.classes[name].doc)
                                     for name, c in base.classes.items()
                                     if name in head.classes]
    if not claims and any(a != b for a, b in docs) and reads_doc(trees[1]):
        raise WholeFile('a docstring changes, and the file reads `__doc__`')

    moved, seeds = set(), set()
    why = frame_change(base, head)
    if claims:
        seeds = frame_seeds(base, head)
    elif why:
        try:
            moved = {name for names in moves(*put_back(base, head), module_text).values()
                     for name in names}
        except NotImportOnly as e:
            raise WholeFile(f'{why}, and it is no import-only move (D97: {e})') from None

    # What the diff adds, changes or deletes: a test or a helper by its name,
    # a new or deleted test class by its own.
    ids = {}
    for name, node in head.tests.items():
        old = base.tests.get(name)
        if old is None or ast.dump(old) != ast.dump(node):
            seeds.add(name)
            ids[name] = 'new' if old is None else 'changed'
    for name, node in head.helpers.items():
        old = base.helpers.get(name)
        if old is None or ast.dump(old) != ast.dump(node):
            seeds.add(name)
            readers = [n for other, n in head.names().items() if other != name]
            if not claims and not any(name in mentions(n) for n in readers + head.frame):
                raise WholeFile(f'it adds or changes the helper {name}, which nothing '
                                'in the file reads')
    seeds |= {name for name in [*base.tests, *base.helpers]
              if name not in head.names() and name not in moved}
    for name, c in head.classes.items():
        old = base.classes.get(name)
        if old is None:
            seeds.add(name)
            ids[name] = 'new'
            continue
        if ast.dump(old.frame) != ast.dump(c.frame):
            if claims:
                seeds.add(name)
                ids[name] = 'changed outside its test methods'
                continue
            changed = next((what(n) for n in c.rest
                            if ast.dump(n) not in map(ast.dump, old.rest)),
                           'its bases, its decorators or what it deletes')
            raise WholeFile(f'the class {name} changes outside its test methods: '
                            f'{changed}')
        for method, node in c.tests.items():
            was = old.tests.get(method)
            if was is None or ast.dump(was) != ast.dump(node):
                ids[f'{name}::{method}'] = 'new' if was is None else 'changed'
        # A changed or deleted method makes its class reached below.
    seeds |= {name for name in base.classes if name not in head.classes}

    # The helpers and tests that read a seed, directly or through another
    # (#336 review, L1: a test that calls a test); within a test class, the
    # test methods that read one, or read a reached method of their class
    # through `self`, `cls` or the class's name (L2). A class with a
    # reached method is reached itself, for a subclass or a test that
    # reads it, and the module's reach runs again.
    reached = set(seeds)
    readers = {**head.helpers, **head.tests}
    if claims:
        # A fixture or a constant that reads a seed passes it on to the
        # tests that read it.
        readers.update({name: node for node in head.frame
                        for name in frame_names(node)})
    in_class = {}
    for _ in range(len(head.classes) + 1):
        for _ in range(len(readers) + 1):
            more = {name for name, node in readers.items()
                    if name not in reached and mentions(node) & reached}
            if not more:
                break
            reached |= more
        for name, c in head.classes.items():
            old = base.classes.get(name)
            if old is None:
                continue
            owners = {'self', 'cls', name}
            hit = {m for m in [*c.tests, *old.tests] if f'{name}::{m}' in ids
                   or m not in c.tests or mentions(c.tests[m]) & (reached - {name})}
            for _ in range(len(c.tests) + 1):
                more = {m for m, node in c.tests.items()
                        if m not in hit and attributes(node, owners) & hit}
                if not more:
                    break
                hit |= more
            in_class[name] = (owners, hit)
        grown = {name for name, (_, hit) in in_class.items() if hit} - reached
        if not grown:
            break
        reached |= grown
    for node in head.frame + [c.frame for c in head.classes.values()]:
        hit = sorted(mentions(node) & reached)
        if hit and not claims:
            raise WholeFile(f'{what(node)} reads {hit[0]}, which the diff adds, '
                            'changes or deletes, or which reads one')
    for name, (owners, hit) in in_class.items():
        used = sorted(attributes(head.classes[name].frame, owners) & hit)
        if used and not claims:
            raise WholeFile(f'the class {name} reads {used[0]} outside its test methods, '
                            'which the diff adds, changes or deletes, or which reads one')

    out = []

    def pick(key, node, skip, method=None):
        hit = sorted(mentions(node) & (reached - {skip}))
        if method is not None:
            owners, changed = in_class[skip]
            hit += sorted(f'{a} of {skip}' for a in attributes(node, owners)
                          & (changed - {method}))
        if key in ids or hit:
            out.append((key, ids.get(key) or f'reads {", ".join(hit)}'))

    for node in head.module.body:
        name = getattr(node, 'name', None)
        if node is head.tests.get(name):
            pick(name, node, name)
        elif name in head.classes and node is head.classes[name].node:
            if name in ids:
                out.append((name, ids[name]))
                continue
            for method, test in head.classes[name].tests.items():
                pick(f'{name}::{method}', test, name, method)
    if claims:
        named = {key.split('::')[0] for key, _ in out}
        out += [(name, why) for name, why in claims_readers(head, reached)
                if name not in named]
    if not out and not claims:
        raise WholeFile('by AST it adds or changes no test, and no helper a test '
                        'reads: a comment, a docstring or a deletion')
    return out


# --- #371: a test helper's diff that only adds ------------------------------
#
# A diff to a helper module that only adds top-level functions runs the
# importers that name one, not every importer (#348's pause_clock_at ran all
# of ui/tests/browser, 730 items, through the browser conftest's import).
# A wrong verdict skips tests the change can reach, so every check fails
# closed: anything else keeps every importer.

class NotAddition(Exception):
    """Why a changed test helper keeps every importer."""


def literal(node):
    """ast.literal_eval() takes `node`: a ValueError, or a TypeError for an
    unhashable member such as `{[1]}` (#371 review, M1), says it does not."""
    try:
        ast.literal_eval(node)
    except (ValueError, TypeError):
        return False
    return True


def label(node):
    if isinstance(node, FUNCTIONS) and not node.decorator_list \
            and not PYTEST_READS.fullmatch(node.name):
        return f'the def {node.name}'
    return what(node)


# What pytest collects as a test or a test class (python_functions' and
# python_classes' defaults, which match a prefix).
COLLECTED = re.compile(r'test\w*|Test\w*')


def additions(base_text, head_text):
    """#371's verdict on a test helper module: (functions, imports), the
    names of the top-level defs the diff from `base_text` to `head_text`
    adds and of the imports beside them, when it changes nothing else by
    AST. Each def is undecorated, with literal defaults, since a decorator
    or a default runs on import; its annotations wait until read on the
    server's Python (>=3.14, PEP 649). Each added name is one the module
    neither bound nor read at BASE, a builtin among them, so it shadows
    nothing, and none is a name pytest or Python reads by its presence, a
    test's or test class's among them (a star import collects it). The
    module docstring is no change unless the module reads `__doc__`, as in
    D101. Raises NotAddition with the reason otherwise."""
    if base_text is None:
        raise NotAddition('new on the branch')
    try:
        trees = ast.parse(base_text), ast.parse(head_text)
    except SyntaxError as e:
        raise NotAddition(f'cannot be parsed ({e.msg}, line {e.lineno})') from None
    try:
        base_binds = bindings(trees[0], 'BASE')
        head_binds = bindings(trees[1], 'the module')
    except NotImportOnly as e:
        raise NotAddition(str(e)) from None
    bodies = []
    docs = []
    for tree in trees:
        body = list(tree.body)
        docs.append(body.pop(0).value.value if body and is_docstring(body[0]) else None)
        bodies.append(body)
    if docs[0] != docs[1] and reads_doc(trees[1]):
        raise NotAddition('its docstring changes, and it reads `__doc__` (D101)')
    old = [ast.dump(n) for n in bodies[0]]
    kept = 0
    added = []
    for node in bodies[1]:
        if kept < len(old) and ast.dump(node) == old[kept]:
            kept += 1
        else:
            added.append(node)
    if kept < len(old):
        raise NotAddition(f'it changes or deletes {label(bodies[0][kept])}')
    read = mentions(trees[0]) | set(base_binds)
    functions, imports = [], []
    for node in added:
        if isinstance(node, FUNCTIONS):
            if node.decorator_list:
                raise NotAddition(f'it adds {what(node)}, whose decorator runs on import')
            if not all(literal(d) for d in node.args.defaults + node.args.kw_defaults
                       if d is not None):
                raise NotAddition(f'it adds the def {node.name}, a default of which '
                                  'runs on import')
            names, into = [node.name], functions
        elif is_import(node):
            names, into = [(a.asname or a.name).split('.')[0] for a in node.names], imports
        else:
            raise NotAddition(f'it adds {what(node)}')
        for name in names:
            if PYTEST_READS.fullmatch(name) or COLLECTED.fullmatch(name):
                raise NotAddition(f'it adds {name}, which pytest or Python reads by '
                                  'its name')
            if name in read:
                raise NotAddition(f'it adds {name}, which the module bound or read '
                                  'before')
            if head_binds.get(name) is AMBIGUOUS:
                raise NotAddition(f'it binds {name} more than once')
            into.append(name)
    if not functions:
        raise NotAddition('by AST it adds no function')
    return functions, imports


def namers(tree, rel, names):
    """For a helper `rel` whose diff only adds `names`: (tests, conftests,
    naming), where naming lists the files that import `rel` (through any
    test-folder file, Tree.reach()) and name one of `names` as a whole
    word, and tests and conftests are the test files and conftests among
    them and among every file that imports one of them (#371 review, H1:
    test_kiosk_ondeck_labels.py imports open_kiosk from
    test_kiosk_pages.py). A star import among the importers, which takes in
    a name without naming it, an importer that can't be parsed, or no
    importer that names one, raises NotAddition."""
    word = re.compile(r'\b(?:' + '|'.join(map(re.escape, names)) + r')\b')
    naming = []
    for other in tree.reach(module_name(rel)):
        try:
            parsed = ast.parse(tree.text(other))
        except SyntaxError as e:
            raise NotAddition(f'{other} cannot be parsed ({e.msg}, line {e.lineno})') \
                from None
        if any(isinstance(n, ast.ImportFrom) and any(a.name == '*' for a in n.names)
               for n in ast.walk(parsed)):
            raise NotAddition(f'{other} has a star import')
        if word.search(tree.text(other)):
            naming.append(other)
    if not naming:
        raise NotAddition(f'nothing that imports it names {", ".join(names)}')
    found = set(naming).union(*(tree.reach(module_name(other)) for other in naming))
    return (sorted(f for f in found if Path(f).name.startswith('test_')),
            sorted(f for f in found if Path(f).name == 'conftest.py'), naming)


# --- output ----------------------------------------------------------------

def collapse(targets):
    """Drops a target inside a folder target."""
    folders = [t for t in targets if not t.endswith('.py')]
    return sorted(t for t in set(targets)
                  if not any(t != f and t.startswith(f + '/') for f in folders))


def browser_files(tree, targets):
    out = set()
    for t in targets:
        if t.endswith('.py'):
            out.add(t)
        else:
            out.update(r for r in tree.test_files() if r.startswith(t + '/'))
    return sorted(r for r in out if tree.exists(r) and is_browser_test(tree, r))


def first_hit(tree, rel, pattern):
    return text_hit(tree.text(rel), pattern)


NO_BASE = object()  # --stdin: no BASE to compare with


def text_hit(text, pattern):
    for number, line in enumerate(text.splitlines(), 1):
        hit = pattern.search(line)
        if hit:
            return f'line {number}: {hit.group(0)}'
    return None


def load_repeats(rel, base, head, module_text, postgres=False):
    """The "Repeats under load" lines for the changed browser test file
    `server/rel` from `base`, its text at BASE (None when it is new on the
    branch, NO_BASE under --stdin), to `head`: none for an import-only move
    (D97), else the count the whole file's text sets, for the tests D101
    picks, or the whole file and why."""
    out = []
    say = out.append
    if base is not NO_BASE:
        try:
            moved = import_only(base, head, module_text)
        except NotImportOnly as why:
            moved = None
            not_moved = str(why)
        if moved:
            say(f'  {rel}: import-only (D97): none')
            for module, names in sorted(moved.items()):
                say(f'      moves {", ".join(names)} unchanged to {module}, '
                    'which it imports from; a flake ticket still repeats it 25 times')
            return out
    timing = text_hit(head, TIMING)
    count = 25 if timing else 5
    kind = (f'involves timing ({timing})' if timing
            else 'deterministic: check that it waits on no poll, timer or animation')
    say(f'  {rel}: {count} repeats, {kind}')
    if base is not NO_BASE:
        say(f'      not an import-only move (D97): {not_moved}')
    try:
        if base is NO_BASE:
            raise WholeFile('--stdin has no BASE to compare with')
        picked = changed_tests(base, head, module_text)
    except WholeFile as why:
        say(f'      the whole file (D101): {why}')
        targets = rel
    else:
        say('      the tests it adds or changes, and those that read a helper it adds '
            'or changes (D101):')
        for key, reason in picked:
            say(f'        {key}: {reason}')
        say(f'      a flake ticket repeats the whole file {rel} 25 times instead, on '
            'the database it failed on (D101)')
        targets = ' '.join(f'{rel}::{key}' for key, _ in picked)
    pg = '--postgres ' if postgres else ''
    run = f'tools/pytest-under-load.sh {pg}-m browser -n 4 --count {count} {targets}'
    say(f'      {run}')
    if text_hit(head, MEASURES):
        say(f'      DERBYNET_BROWSER_FONT="DejaVu Sans" {run}')
    return out


def report(plan, tree):
    out = []
    say = out.append
    source = f'{plan.base}...HEAD and the working tree' if plan.from_git else 'stdin'
    say(f'affected-tests: {len(plan.covers)} changed files ({source}); '
        'owner, 2026-11-11: run what the diff can reach, and leave the full '
        'suites to CI.')
    say('')
    all_targets = []
    for path, entries in plan.covers.items():
        say(path)
        for rule, note, targets in entries:
            say(f'  [{rule}] {note}')
            shown = collapse([t for t in targets if run_kind(tree, t) != 'browser'])
            shown += collapse([t for t in targets if run_kind(tree, t) != 'plain'])
            for t in sorted(set(shown)):
                say(f'      {t}')
            all_targets += targets
    say('')

    if plan.everything:
        say('CI runs the full suites on both databases (D85): push and let its run '
            'be the check, and run the targeted tests below locally:')
        for why in dict.fromkeys(plan.everything):
            say(f'  {why}')
    targets = [t for t in set(all_targets) if tree.exists(t)]
    checked = sorted(set(targets) & tree.source_checks())
    if checked:
        say('tools/source-checks.sh runs these, so the commands leave them out: '
            + ', '.join(checked))
        targets = [t for t in targets if t not in checked]
    say('')

    # Each command folds a file into a folder it runs: a plain run of ui/tests
    # runs none of ui/tests/browser, so the browser run keeps those.
    browser = collapse([t for t in targets if run_kind(tree, t) != 'plain'])
    plain = collapse([t for t in targets if run_kind(tree, t) != 'browser'])
    measured = browser_files(tree, browser)
    measured = [r for r in measured if first_hit(tree, r, MEASURES)]

    if plan.postgres:
        say('Postgres: needed (owner, 2026-11-11: models, migrations, services, '
            'modules that import models or write the database, querysets, raw SQL, '
            'the database settings or populated.py):')
        for why in dict.fromkeys(plan.postgres):
            say(f'  {why}')
    else:
        say('Postgres: not needed; the diff touches no model, migration, service, '
            'module that imports models or writes the database, queryset, raw SQL, '
            'database setting or populated.py, and CI runs it (owner, 2026-11-11).')
    say('')
    if measured:
        say('Measures text, so also run with DERBYNET_BROWSER_FONT="DejaVu Sans", '
            'CI\'s font (#273):')
        for r in measured:
            say(f'  {r} ({first_hit(tree, r, MEASURES)})')
    else:
        say('Measures text: none of the browser tests it runs.')
    say('')
    if plan.changed_browser_tests:
        say('Repeats under load (D85), on the changed test files only: the tests '
            'each adds or changes, by node id, and those that read a helper it adds '
            'or changes (D101); none for an import-only move (D97). A flake ticket '
            'keeps 25 of the whole file, on the database it failed on, whatever this '
            'prints (owner, 2026-11-11):')
        if not plan.from_git:
            say('  (--stdin has no BASE to compare with, so no file counts as an '
                'import-only move, D97: each keeps its count, of the whole file, D101)')
        for r in plan.changed_browser_tests:
            base = base_text(plan, r) if plan.from_git else NO_BASE
            out += load_repeats(r, base, tree.text(r), lambda name: module_text(tree, name),
                                plan.postgres)
    else:
        say('Repeats under load: no browser test file changed.')
    say('')

    # #312 restarted its hand-off run for a docstring's numbers no assert
    # read, and never listed its operand mutants.
    claimed = plan.changed_tests + plan.changed_helpers
    base = f' --base {plan.base}' if plan.from_git else ''
    if claimed or plan.changed_source:
        say('Before the first hand-off run, from server/: settle what these list, '
            'since an edit restarts the runs below (#312 retro):')
        if claimed:
            say(f'  uv run python tools/docstring_claims.py {" ".join(claimed)}')
            # #341 checked two of its four changed test files, and a
            # catch-all row for the rest failed review (#341 retro); --base
            # asks only for the claims the diff adds or changes (D123).
            say(f'  uv run python tools/docstring_claims.py --check <the PR body draft>{base} '
                + ' '.join(claimed))
        if plan.changed_source:
            say(f'  uv run python tools/operand_mutants.py{base}')
            # #336 picked its mutants by hand, mostly one way, and 21 of 98
            # survived on branches no test reached (#336 retro).
            say(f'  uv run python tools/mutate.py --listed{base} -- '
                '<the node ids of the tests that cover them>')
        # --listed skips a test file unless --file names it, and then
        # mutates its helpers, such as #345's scanner (#345 retro, PR #364).
        for path in plan.changed_tests:
            say(f'  uv run python tools/mutate.py --listed{base} --file {path} -- '
                '<the node ids of the tests that call its helpers>')
        say('')

    say('Run from server/ (start a run longer than a minute in the background):')
    if plain:
        say(f'  uv run pytest -n auto {" ".join(plain)}')
    if browser:
        say(f'  uv run pytest -n auto -m browser {" ".join(browser)}')
    if plan.postgres:
        if plain:
            say(f'  tools/pytest-postgres.sh -n auto {" ".join(plain)}')
        if browser:
            say(f'  tools/pytest-postgres.sh -n auto -m browser {" ".join(browser)}')
    if not plain and not browser:
        say('  (no pytest target: CI\'s full run covers the diff, D85)' if plan.everything
            else '  (no pytest target: the checks below cover the diff)')
    if measured:
        say(f'  DERBYNET_BROWSER_FONT="DejaVu Sans" uv run pytest -n auto -m browser '
            f'{" ".join(measured)}')
    for line in plan.commands:
        say(f'  {line}')
    say('  tools/source-checks.sh')
    say('  uv run ruff check && uv run ruff format --check')
    # The hook runs the whole script, plan/tests and all: #373's made-up path
    # in a test string read as a cite, and the hook said so about 15 min into
    # its run, a push round later (#373 retro).
    say('')
    say('Before each push, from server/ (about a minute: the pre-push hook '
        'runs the whole script, about 15 min, #373 retro):')
    say('  tools/source-checks.sh --quick')
    return '\n'.join(out) + '\n'


def main(argv):
    args = list(argv)
    root = None
    from_stdin = '--stdin' in args
    if from_stdin:
        args.remove('--stdin')
    if '--root' in args:
        i = args.index('--root')
        root = Path(args[i + 1]).resolve()
        del args[i:i + 2]
    if len(args) > 1 or any(a.startswith('-') for a in args):
        print(__doc__, file=sys.stderr)
        return 2
    base = args[0] if args else 'origin/master'
    if root is None:
        root = Path(git(Path.cwd(), 'rev-parse', '--show-toplevel').strip())
    if from_stdin:
        files = [ln.strip() for ln in sys.stdin if ln.strip()]
    else:
        files = None
    plan = Plan(root=root, from_git=not from_stdin, base=base)
    if files is None:
        files = changed_files(plan)
    tree = Tree(root)
    for path in files:
        map_file(plan, tree, path)
    sys.stdout.write(report(plan, tree))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
