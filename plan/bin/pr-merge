#!/bin/bash
# Merges PR <number> only if every check on its current head passed, pinning the
# merge to that head SHA so a push after the check can't slip in. Then prints
# each issue the PR closes with its state, and exits 1 if one is still open.
#
# Usage: plan/bin/pr-merge <pr> [--squash|--rebase|--merge] [--delete-branch]
# With no merge method it squashes and deletes the branch, as the plan's PRs do.
set -euo pipefail
PR=${1:?usage: pr-merge <pr> [--squash|--rebase|--merge] [--delete-branch]}
shift
case " $* " in
  *" --squash "*|*" --rebase "*|*" --merge "*|*" -s "*|*" -r "*|*" -m "*) ;;
  *) set -- --squash --delete-branch "$@" ;;
esac
GH=${GH:-gh}
REPO=${REPO:-PorkChopExpress86/derbynet}
# GitHub closes the issues a few seconds after the merge.
CLOSE_WAIT=${CLOSE_WAIT:-30}

head=$("$GH" pr view "$PR" --repo "$REPO" --json headRefOid --jq .headRefOid)
# A push of the head commit to parity-check/<name> runs the parity gate on the
# same SHA (.github/workflows/parity.yml), so its checks show on the PR. The
# gate is not a pull request check yet; leave those runs out.
not_passed=$("$GH" pr checks "$PR" --repo "$REPO" --json bucket,name,workflow,event \
               --jq '.[] | select(.bucket != "pass" and .bucket != "skipping")
                     | select(.workflow != "parity" or .event != "push")
                     | "\(.bucket) \(.name)"')
if [ -n "$not_passed" ]; then
  echo "not merging #$PR; checks on $head not passed:" >&2
  echo "$not_passed" >&2
  exit 1
fi
# An issue whose body has a "## Still open" section stays open for what that
# section names (plan/README.md), so a PR that would close it is refused here
# rather than the issue reopened after the merge.
held=()
for n in $("$GH" pr view "$PR" --repo "$REPO" --json closingIssuesReferences \
             --jq '.closingIssuesReferences[].number'); do
  if "$GH" issue view "$n" --repo "$REPO" --json state,body \
       --jq 'select(.state == "OPEN") | .body' | tr -d '\r' |
     awk '/^## /{on = ($0 == "## Still open"); next} on && NF {found = 1} END {exit !found}'; then
    held+=("#$n")
  fi
done
if [ ${#held[@]} -gt 0 ]; then
  echo "not merging #$PR; it closes ${held[*]}, whose body has a \"## Still open\" section; write \"Part of #N\" in the PR body instead" >&2
  exit 1
fi
"$GH" pr merge "$PR" --repo "$REPO" --match-head-commit "$head" "$@"
"$GH" pr view "$PR" --repo "$REPO" --json state,mergeCommit --jq '"\(.state) \(.mergeCommit.oid)"'

# A main checkout left on a branch master already has (merging it would change
# nothing, so squash merges count) reads an old tree: an old .gitignore, old
# plan docs.  Say so; switching is left to whoever owns it.  A note is a hint,
# so nothing in it may fail the script after a merge.
(
  main=$(git worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p')
  if [ -n "$main" ] && git -C "$main" fetch -q origin master 2>/dev/null; then
    branch=$(git -C "$main" branch --show-current)
    if [ -n "$branch" ] && [ "$branch" != master ] &&
       [ "$(git -C "$main" merge-tree --write-tree origin/master "$branch" 2>/dev/null)" = \
         "$(git -C "$main" rev-parse 'origin/master^{tree}')" ]; then
      echo "note: $main is on $branch, which master already has; run: git -C $main switch master && git -C $main pull --ff-only" >&2
    fi
  fi
) || true

# With --auto the PR merges later, so there is nothing to check yet.
case " $* " in *" --auto "*) exit 0 ;; esac
closes=$("$GH" pr view "$PR" --repo "$REPO" --json closingIssuesReferences \
           --jq '.closingIssuesReferences[].number')
[ -n "$closes" ] || exit 0
waited=0
while :; do
  still_open=()
  report=()
  for n in $closes; do
    state=$("$GH" issue view "$n" --repo "$REPO" --json state --jq .state)
    report+=("#$n $state")
    [ "$state" = OPEN ] && still_open+=("#$n")
  done
  if [ ${#still_open[@]} -eq 0 ] || [ "$waited" -ge "$CLOSE_WAIT" ]; then
    break
  fi
  sleep 5
  waited=$((waited + 5))
done
printf '%s\n' "${report[@]}"
if [ ${#still_open[@]} -gt 0 ]; then
  echo "#$PR is merged, but ${still_open[*]} it closes is still open; close it, or add a \"## Still open\" section to its body (plan/README.md)" >&2
  exit 1
fi
