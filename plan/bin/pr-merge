#!/bin/bash
# Merges PR <number> only if every check on its current head passed, pinning the
# merge to that head SHA so a push after the check can't slip in. Then prints
# each issue the PR closes with its state, and exits 1 if one is still open.
#
# A source check (a test server/tools/source-checks.sh runs, that script, or
# plan/tests) reads code across the tree, in any area: #304 added
# test_pipefail_pipes.py while #309 added `anchors ... | grep -q` pipes to
# server/docs/adr/check-paths.sh, and the lead's trial merge of the two heads
# found it (#61 retro). So when origin/master moved since the PR head's merge
# base, and one side changed a source check while the other changed code one
# reads (a .sh or .py file, a workflow, a git hook or a plan/bin tool), it
# merges the PR's head with origin/master in a temporary worktree under
# ${XDG_CACHE_HOME:-~/.cache}, runs server/tools/source-checks.sh there, and
# removes the worktree whatever happens, Ctrl-C included (#311). The run took
# 5 min 10 s on the lead's machine at a load average of 25, about 4 min of it
# in plan/tests; uv run --locked builds the worktree's server/.venv from uv's
# cache in about a second. It needs uv on PATH, and it can't run under
# `timeout`, which source-checks.sh refuses. It refuses the PR when the merge
# conflicts or a check fails, and prints the failures' summary lines; the
# whole output stays in ${XDG_CACHE_HOME:-~/.cache}/derbynet-pr-merge-<pr>.log.
# A passing run is recorded by its pair of PR head and origin/master SHAs in
# $(git rev-parse --git-common-dir)/pr-merge-source-checks, and a later run
# on the same pair, --base-checked or --dry-run included, skips it and says
# so. A template, CSS, JavaScript or Markdown change against a new source
# check is left to CI on master.
#
# Then it refuses when origin/master has commits since the PR head's merge
# base that touch an area the PR touches too: plan/, .githooks/,
# server/tools/, .github/, a conftest.py (any folder), server/pyproject.toml
# or server/uv.lock. CI then ran on a base without them. #289 passed CI on a
# base without #288, both changing plan/, and merged after it; the lead
# checked the combination by hand. It prints the overlapping paths and what
# plan/bin/affected-tests maps the combined diff to. After that run on the
# PR merged with origin/master, --base-checked merges anyway.
#
# Usage: plan/bin/pr-merge <pr> [--base-checked] [--dry-run] [--squash|--rebase|--merge] [--delete-branch]
#   --base-checked  skips the area rule, once the combined diff's affected
#                   tests ran on the merge; the source-check run still runs
#   --dry-run       runs every check above, and stops before the merge
#   -h, --help      prints this
# With no merge method it squashes and deletes the branch, as the plan's PRs do.
set -euo pipefail
usage='usage: pr-merge <pr> [--base-checked] [--dry-run] [--squash|--rebase|--merge] [--delete-branch]'
case ${1:-} in
  -h|--help) sed -n '2,/^set -euo/{/^#/s/^# \{0,1\}//p}' "$0"; exit 0 ;;
esac
PR=${1:?$usage}
shift
base_checked=0
dry_run=0
rest=()
for arg in "$@"; do
  case $arg in
    --base-checked) base_checked=1 ;;
    --dry-run) dry_run=1 ;;
    *) rest+=("$arg") ;;
  esac
done
set -- ${rest[@]+"${rest[@]}"}
case " $* " in
  *" --squash "*|*" --rebase "*|*" --merge "*|*" -s "*|*" -r "*|*" -m "*) ;;
  *) set -- --squash --delete-branch "$@" ;;
esac
GH=${GH:-gh}
REPO=${REPO:-PorkChopExpress86/derbynet}
# GitHub closes the issues a few seconds after the merge.
CLOSE_WAIT=${CLOSE_WAIT:-30}

head=$("$GH" pr view "$PR" --repo "$REPO" --json headRefOid --jq .headRefOid)
# A push of the head commit to parity-check/<name> runs the parity gate on the
# same SHA (.github/workflows/parity.yml), so its checks show on the PR. The
# gate is not a pull request check yet; leave those runs out.
not_passed=$("$GH" pr checks "$PR" --repo "$REPO" --json bucket,name,workflow,event \
               --jq '.[] | select(.bucket != "pass" and .bucket != "skipping")
                     | select(.workflow != "parity" or .event != "push")
                     | "\(.bucket) \(.name)"')
if [ -n "$not_passed" ]; then
  echo "not merging #$PR; checks on $head not passed:" >&2
  echo "$not_passed" >&2
  exit 1
fi
# The areas whose change on master since the merge base the PR's CI never saw:
# each path printed as "<area>\t<path>".
areas() {
  awk '{
    if ($0 ~ /^(plan|\.githooks|\.github)\//) { split($0, p, "/"); a = p[1] "/" }
    else if ($0 ~ /^server\/tools\//) a = "server/tools/"
    else if ($0 ~ /(^|\/)conftest\.py$/) a = "conftest.py"
    else if ($0 == "server/pyproject.toml" || $0 == "server/uv.lock") a = $0
    else next
    print a "\t" $0
  }'
}
# The source-check run's worktree, and its process group while it runs. The
# run has a session of its own, so a Ctrl-C reaches only this script, whose
# trap stops the run, waits for it, and removes the worktree.
wt=
checks_pid=
remove_worktree() {
  if [ -n "$checks_pid" ]; then
    kill -TERM -- "-$checks_pid" 2>/dev/null || true
    wait "$checks_pid" 2>/dev/null || true
    # uv and pytest, below source-checks.sh, get the TERM too; a run that
    # ignores it is killed after about 10 s.
    for _ in $(seq 50); do
      kill -0 -- "-$checks_pid" 2>/dev/null || break
      sleep 0.2
    done
    kill -KILL -- "-$checks_pid" 2>/dev/null || true
    checks_pid=
  fi
  if [ -n "$wt" ]; then
    git worktree remove --force --force "$wt" 2>/dev/null || true
    rm -rf "$wt"
    git worktree prune || true
    wt=
  fi
}
trap remove_worktree EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}
passed_file=$(git rev-parse --path-format=absolute --git-common-dir)/pr-merge-source-checks
# source_checks_on_the_merge: runs server/tools/source-checks.sh on $head
# merged with $master, or says the pair already passed. Fails, saying why,
# when the merge conflicts, uv is missing, or a check fails.
source_checks_on_the_merge() {
  if grep -qFx "$head $master" "$passed_file" 2>/dev/null; then
    echo "the source checks passed on ${head:0:8} merged with origin/master ${master:0:8} before ($passed_file); not running them again" >&2
    return 0
  fi
  local out status tree merge log
  out=$(git merge-tree --write-tree --name-only --no-messages "$master" "$head") && status=0 || status=$?
  if [ "$status" = 1 ]; then
    echo "not merging #$PR; it conflicts with origin/master ${master:0:8}, so the source checks can't run on the merge. Merge origin/master into the branch, push, and wait for CI again. The conflicts:" >&2
    tail -n +2 <<<"$out" | sed 's/^/  /' >&2
    return 1
  elif [ "$status" != 0 ]; then
    echo "not merging #$PR; git merge-tree could not merge ${head:0:8} with origin/master ${master:0:8}:" >&2
    echo "$out" >&2
    return 1
  fi
  if ! command -v uv >/dev/null; then
    echo "not merging #$PR; uv is not on PATH, and server/tools/source-checks.sh needs it to run the source checks on the PR merged with origin/master. Install uv (server/README.md) and rerun." >&2
    return 1
  fi
  tree=$(head -n 1 <<<"$out")
  # set -e is off in a function called with ||, so each step says so itself.
  if ! merge=$(GIT_AUTHOR_NAME=pr-merge GIT_AUTHOR_EMAIL=pr-merge@localhost \
               GIT_COMMITTER_NAME=pr-merge GIT_COMMITTER_EMAIL=pr-merge@localhost \
               git commit-tree --no-gpg-sign "$tree" -p "$master" -p "$head" \
                 -m "pr-merge: #$PR merged with origin/master, for the source checks") ||
     ! mkdir -p "$cache_dir" ||
     ! wt=$(mktemp -d "$cache_dir/derbynet-pr-merge.XXXXXX") ||
     ! git worktree add -q --detach "$wt" "$merge"; then
    echo "not merging #$PR; could not make a worktree of the PR merged with origin/master under $cache_dir to run the source checks in" >&2
    return 1
  fi
  if [ ! -f "$wt/server/tools/source-checks.sh" ]; then
    echo "not merging #$PR; the PR merged with origin/master has no server/tools/source-checks.sh to run" >&2
    return 1
  fi
  log=$cache_dir/derbynet-pr-merge-$PR.log
  echo "running server/tools/source-checks.sh on #$PR merged with origin/master (${merge:0:8}) in $wt; it takes about 5 min under load, output in $log" >&2
  (cd "$wt" && exec setsid bash server/tools/source-checks.sh) </dev/null >"$log" 2>&1 &
  checks_pid=$!
  wait "$checks_pid" && status=0 || status=$?
  checks_pid=
  remove_worktree
  if [ "$status" != 0 ]; then
    echo "not merging #$PR; server/tools/source-checks.sh failed (exit $status) on the PR merged with origin/master ${master:0:8}. Its summary lines, and the whole output in $log:" >&2
    out=$(grep -E '^(FAIL|ERROR): |^(FAILED|ERROR) |^FAILED \(|^Ran [0-9]+ tests? in |^(=+ )?[0-9]+ [a-z]+.* in [0-9.]+s' "$log" || true)
    [ -n "$out" ] || out=$(tail -n 20 "$log")
    echo "$out" >&2
    return 1
  fi
  rm -f "$log"
  echo "$head $master" >>"$passed_file"
  echo "the source checks passed on #$PR merged with origin/master ${master:0:8}" >&2
}
if ! git fetch -q origin master "refs/pull/$PR/head" 2>/dev/null ||
   ! git cat-file -e "$head^{commit}" 2>/dev/null ||
   ! base=$(git merge-base "$head" origin/master 2>/dev/null); then
  echo "not merging #$PR; could not fetch origin/master and its head $head, which the source checks and the area rule read; fetch them and rerun" >&2
  exit 1
fi
master=$(git rev-parse origin/master)
pr_paths=$(git diff --name-only "$base" "$head" | areas)
master_paths=$(git diff --name-only "$base" "$master" | areas)
# One collation for sort and comm: this host's comm (uutils) compares
# bytes while sort follows en_US.UTF-8, which puts conftest.py before
# .github/: #295's merge printed "comm: file 1 is not in sorted order",
# and an area both sides changed could go unseen (#206 retro).
shared=$(LC_ALL=C comm -12 <(cut -f1 <<<"$pr_paths" | LC_ALL=C sort -u) \
           <(cut -f1 <<<"$master_paths" | LC_ALL=C sort -u) | grep . || true)
pr_all=$(git diff --name-only "$base" "$head")
master_all=$(git diff --name-only "$base" "$master")
# The source checks, as either side's source-checks.sh lists them.
checks=$({ git show "$head:server/tools/source-checks.sh" 2>/dev/null || true
           git show "$master:server/tools/source-checks.sh" 2>/dev/null || true; } |
         sed -nE 's,^[[:space:]]+([A-Za-z0-9_./-]+\.py).*,server/\1,p'
         echo server/tools/source-checks.sh)
is_check() { # is_check <paths>: those that are source checks
  { grep -Fx -f <(echo "$checks") <<<"$1"; grep '^plan/tests/' <<<"$1"; } | sort -u || true
}
# The code a source check reads, by kind of file.
is_code() { grep -E '\.(sh|py)$|^\.github/workflows/|^\.githooks/|^plan/bin/' <<<"$1" || true; }
pr_checks=$(is_check "$pr_all")
master_checks=$(is_check "$master_all")
pr_code=$(is_code "$pr_all")
master_code=$(is_code "$master_all")
if { [ -n "$pr_checks" ] && [ -n "$master_code" ]; } ||
   { [ -n "$master_checks" ] && [ -n "$pr_code" ]; }; then
  {
    echo "origin/master moved since #$PR's merge base ${base:0:8}, and a source check one side changed reads code the other changed:"
    mapfile -t moved < <(printf '%s\n' "$master_checks" "$master_code" | grep . | sort -u)
    git log --format='  %h %s' "$base..$master" -- "${moved[@]}"
    if [ -n "$master_checks" ] && [ -n "$pr_code" ]; then
      sed 's/^/  master check:  /' <<<"$master_checks"
      sed 's/^/  this PR code:  /' <<<"$pr_code"
    fi
    if [ -n "$pr_checks" ] && [ -n "$master_code" ]; then
      sed 's/^/  this PR check: /' <<<"$pr_checks"
      sed 's/^/  master code:   /' <<<"$master_code"
    fi
  } >&2
  source_checks_on_the_merge || exit 1
fi
if [ -n "$shared" ] && [ "$base_checked" = 0 ]; then
  {
    echo "not merging #$PR; origin/master moved since its merge base ${base:0:8}, in an area the PR also changes, so CI ran without these commits:"
    mapfile -t moved < <(awk -F'\t' 'NR == FNR { s[$1]; next } $1 in s { print $2 }' <(echo "$shared") <(echo "$master_paths"))
    git log --format='  %h %s' "$base..$master" -- "${moved[@]}"
    for area in $shared; do
      echo "$area"
      awk -F'\t' -v a="$area" '$1 == a { print "  master:  " $2 }' <<<"$master_paths"
      awk -F'\t' -v a="$area" '$1 == a { print "  this PR: " $2 }' <<<"$pr_paths"
    done
    echo "Run what plan/bin/affected-tests prints for the combined diff on the PR merged with origin/master, then rerun with --base-checked; or update the branch (gh pr update-branch $PR) and wait for CI again. For the combined diff it prints:"
    { git diff --name-only "$base" "$head"; git diff --name-only "$base" "$master"; } | sort -u |
      "${AFFECTED:-$(dirname "$0")/affected-tests}" --stdin || echo "(affected-tests failed)"
  } >&2
  exit 1
fi
# An issue whose body has a "## Still open" section stays open for what that
# section names (plan/README.md), so a PR that would close it is refused here
# rather than the issue reopened after the merge.
held=()
for n in $("$GH" pr view "$PR" --repo "$REPO" --json closingIssuesReferences \
             --jq '.closingIssuesReferences[].number'); do
  if "$GH" issue view "$n" --repo "$REPO" --json state,body \
       --jq 'select(.state == "OPEN") | .body' | tr -d '\r' |
     awk '/^## /{on = ($0 == "## Still open"); next} on && NF {found = 1} END {exit !found}'; then
    held+=("#$n")
  fi
done
if [ ${#held[@]} -gt 0 ]; then
  echo "not merging #$PR; it closes ${held[*]}, whose body has a \"## Still open\" section; write \"Part of #N\" in the PR body instead" >&2
  exit 1
fi
if [ "$dry_run" = 1 ]; then
  echo "dry run: #$PR would merge at $head" >&2
  exit 0
fi
"$GH" pr merge "$PR" --repo "$REPO" --match-head-commit "$head" "$@"
"$GH" pr view "$PR" --repo "$REPO" --json state,mergeCommit --jq '"\(.state) \(.mergeCommit.oid)"'

# A main checkout left on a branch master already has (merging it would change
# nothing, so squash merges count) reads an old tree: an old .gitignore, old
# plan docs.  Say so; switching is left to whoever owns it.  A note is a hint,
# so nothing in it may fail the script after a merge.
(
  main=$(git worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p')
  if [ -n "$main" ] && git -C "$main" fetch -q origin master 2>/dev/null; then
    branch=$(git -C "$main" branch --show-current)
    if [ -n "$branch" ] && [ "$branch" != master ] &&
       [ "$(git -C "$main" merge-tree --write-tree origin/master "$branch" 2>/dev/null)" = \
         "$(git -C "$main" rev-parse 'origin/master^{tree}')" ]; then
      echo "note: $main is on $branch, which master already has; run: git -C $main switch master && git -C $main pull --ff-only" >&2
    fi
  fi
) || true

# With --auto the PR merges later, so there is nothing to check yet.
case " $* " in *" --auto "*) exit 0 ;; esac
closes=$("$GH" pr view "$PR" --repo "$REPO" --json closingIssuesReferences \
           --jq '.closingIssuesReferences[].number')
[ -n "$closes" ] || exit 0
waited=0
while :; do
  still_open=()
  report=()
  for n in $closes; do
    state=$("$GH" issue view "$n" --repo "$REPO" --json state --jq .state)
    report+=("#$n $state")
    [ "$state" = OPEN ] && still_open+=("#$n")
  done
  if [ ${#still_open[@]} -eq 0 ] || [ "$waited" -ge "$CLOSE_WAIT" ]; then
    break
  fi
  sleep 5
  waited=$((waited + 5))
done
printf '%s\n' "${report[@]}"
if [ ${#still_open[@]} -gt 0 ]; then
  echo "#$PR is merged, but ${still_open[*]} it closes is still open; close it, or add a \"## Still open\" section to its body (plan/README.md)" >&2
  exit 1
fi
