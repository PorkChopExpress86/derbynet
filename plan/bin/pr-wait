#!/bin/bash
# Waits until every check on PR <number>'s current head has finished, then prints
# one "<bucket> <name> <link>" line per check.  Exits 0 only if all passed or
# were skipped.  On a failure it also prints `plan/bin/ci-failures`: each
# failing test, and whether it failed on master lately, and for a job that
# names no test, the step that failed and its error line.  Waits for checks to
# appear first, because GitHub creates the runs a few seconds after a push.
#
# It counts the checks plan/bin/pr-merge counts: a parity-check/<name> push
# of the head runs the parity gate on the same SHA, and those checks show on
# the PR, but pr-merge leaves them out, so pr-wait neither waits for them nor
# fails on them.  It prints them last, under "parity-check push (not
# counted):".  #295's red `leg (django, *)` jobs there made pr-wait exit 1 on
# a PR pr-merge then merged (#206 retro).
#
# Usage: plan/bin/pr-wait <pr or branch> [--timeout-min N]   (default 90)
#
# A branch names its PR, as `gh pr checks` takes it, so an implementer waits
# on every workflow of its head: #58's own waiter watched image.yml alone and
# reported CI green while server.yml's pytest (sqlite) was red (#58 retro).
set -euo pipefail
PR=${1:?usage: pr-wait <pr or branch> [--timeout-min N]}
TIMEOUT_MIN=${3:-90}
GH=${GH:-gh}
REPO=${REPO:-PorkChopExpress86/derbynet}

# A network error from gh is retried, so one dropped request does not end the wait.
head_of() {
  local n
  for n in 1 2 3 4 5; do
    "$GH" pr view "$PR" --repo "$REPO" --json headRefOid --jq .headRefOid 2>/dev/null && return
    sleep ${PR_WAIT_RETRY_SLEEP:-10}
  done
  echo "gh could not read PR #$PR after 5 tries" >&2
  return 1
}

head=$(head_of)
echo "PR #$PR head $head" >&2
deadline=$(( $(date +%s) + TIMEOUT_MIN * 60 ))
while :; do
  now_head=$(head_of)
  if [ "$now_head" != "$head" ]; then
    echo "head moved to $now_head while waiting; rerun pr-wait" >&2
    exit 2
  fi
  # bucket is pass, fail, pending, skipping, or cancel
  all=$("$GH" pr checks "$PR" --repo "$REPO" --json bucket,name,link,workflow,event \
          --jq '.[] | (if .workflow == "parity" and .event == "push"
                       then "parity-push " else "" end)
                    + "\(.bucket) \(.name) \(.link)"' 2>/dev/null || true)
  checks=$(grep -v '^parity-push ' <<<"$all" || true)
  parity=$(sed -n 's/^parity-push //p' <<<"$all")
  if [ -n "$checks" ] && ! grep -q '^pending ' <<<"$checks"; then
    echo "$checks"
    if [ -n "$parity" ]; then
      echo "parity-check push (not counted):"
      sed 's/^/  /' <<<"$parity"
    fi
    grep -qvE '^(pass|skipping) ' <<<"$checks" || exit 0
    # Which failing tests also failed on master lately: a known flake (#212 retro).
    echo "ci-failures:"
    GH="$GH" REPO="$REPO" "$(dirname "$0")/ci-failures" "$PR" || true
    exit 1
  fi
  if [ "$(date +%s)" -ge "$deadline" ]; then
    echo "timed out after $TIMEOUT_MIN min; still pending:" >&2
    echo "${checks:-no checks yet}" >&2
    exit 3
  fi
  sleep 30
done
