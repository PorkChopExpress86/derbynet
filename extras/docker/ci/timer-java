#! /bin/bash
#
# java for testing/race-with-derby-timer.sh (its JAVA), run in TIMER_IMAGE,
# so `checks.sh timer` races the image's jar with that script's bounds,
# tracing and thread dumps (#518).
#
# The container runs as this user on the host's network, with the repository
# mounted at its own path: the jar reaches the server at the address the
# script polls, and writes its -logdir log where the script reads it.
# `docker run` stays in the foreground, so the script's child runs while the
# container does, and it passes each signal on, the script's SIGQUIT and
# SIGTERM included, through tini to java.  PREFIX names the container.

set -euo pipefail
root="$(cd "$(dirname "$0")/../../.." && pwd)"
exec docker run --rm --name "${PREFIX:?set PREFIX}-timer" --network host \
    --user "$(id -u):$(id -g)" -v "$root:$root" \
    --entrypoint /usr/bin/tini "${TIMER_IMAGE:?set TIMER_IMAGE}" -- java "$@"
