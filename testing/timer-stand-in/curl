#! /bin/bash
#
# A stand-in for curl, first on the PATH in race-with-derby-timer-cases.sh
# (#399).  With TIMER_STATE set, each poll.coordinator answer reports the
# timer in that state, so a case can hide the states Django leads with;
# anything else goes to the next curl on the PATH unchanged.

HERE=$(cd "$(dirname "$0")" && pwd)
REAL=$(PATH=$(echo "$PATH" | tr ':' '\n' | grep -vxF "$HERE" | paste -sd:) command -v curl)
case " $* " in
    *query=poll.coordinator*) [ -n "$TIMER_STATE" ] || exec "$REAL" "$@" ;;
    *) exec "$REAL" "$@" ;;
esac
set -o pipefail
"$REAL" "$@" | jq -c --argjson s "$TIMER_STATE" '.["timer-state"].state = $s'
