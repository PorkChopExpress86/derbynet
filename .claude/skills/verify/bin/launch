#!/bin/bash
# Starts a fresh, empty instance at http://127.0.0.1:$VERIFY_PORT (default
# 8090).  Ready when it prints "ready".  VERIFY_SERVER=php (default) builds the
# PHP image from this checkout and needs a regular clone, not a git worktree.
# VERIFY_SERVER=django runs server/ from this checkout, a worktree too, with a
# database of its own under server/var/verify-$VERIFY_RUN.
set -euo pipefail
BIN="$(cd "$(dirname "$0")" && pwd)"
source "$BIN/env.sh"
if [ "$KIND" = php ] && docker ps -a --format '{{.Names}}' | grep -qx "$SERVER"; then
  echo "$SERVER already exists; run bin/cleanup first, or pick another VERIFY_RUN" >&2
  exit 1
fi
if ss -ltn | grep -q ":$PORT\b"; then
  echo "port $PORT is taken; set VERIFY_PORT" >&2
  exit 1
fi
if [ "$KIND" = django ]; then
  [ -e "$DJANGO_STATE" ] && { echo "$DJANGO_STATE exists; run bin/cleanup first, or pick another VERIFY_RUN" >&2; exit 1; }
  mkdir -p "$DJANGO_STATE/data" "$DJANGO_STATE/config"
  export DERBYNET_DATA_DIR="$DJANGO_STATE/data" DERBYNET_CONFIG_DIR="$DJANGO_STATE/config"
  cd "$REPO/server"
  uv sync --locked -q > "$EVIDENCE/launch.log" 2>&1 || { tail -20 "$EVIDENCE/launch.log" >&2; exit 1; }
  .venv/bin/python manage.py migrate -v 0 >> "$EVIDENCE/launch.log" 2>&1 \
    || { tail -20 "$EVIDENCE/launch.log" >&2; exit 1; }
  # DEBUG is off, as on race day, and runserver then serves no static files
  # unless --insecure is given.  The python process itself is the pid, so
  # cleanup stops the server and not a wrapper.
  nohup .venv/bin/python manage.py runserver "127.0.0.1:$PORT" --noreload --insecure \
    > "$EVIDENCE/server.log" 2>&1 &
  echo $! > "$PIDFILE"
  for _ in $(seq 30); do
    curl -s -o /dev/null "$BASE/login.php" && break
    sleep 1
  done
  "$BIN/doctor"
  echo ready "$BASE"
  exit 0
fi
"$REPO/testing/docker/run-suite.sh" harness assets server > "$EVIDENCE/launch.log" 2>&1 \
  || { tail -20 "$EVIDENCE/launch.log" >&2; exit 1; }
"$BIN/doctor"
echo ready "$BASE"
