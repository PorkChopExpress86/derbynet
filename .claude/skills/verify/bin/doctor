#!/bin/bash
# Read-only: is this run's instance up, ours, and answering?
set -uo pipefail
source "$(dirname "$0")/env.sh"
ok=1
if [ "$KIND" = django ]; then
  pid=$(cat "$PIDFILE" 2>/dev/null) || { echo "FAIL no $PIDFILE"; exit 1; }
  kill -0 "$pid" 2>/dev/null || { echo "FAIL runserver $pid is not running; see $EVIDENCE/server.log"; exit 1; }
  echo "runserver pid $pid, data $DJANGO_STATE"
  ss -ltnpH "sport = :$PORT" 2>/dev/null | grep -q "pid=$pid," \
    || { echo "FAIL port $PORT is not this runserver's"; ok=0; }
  css=$(curl -s -o /dev/null -w '%{http_code}' "$BASE/static/ui/app.css")
  echo "static/ui/app.css: $css"
  [[ $css == 200 ]] || ok=0
else
state=$(docker inspect -f '{{.State.Status}} {{.Config.Image}}' "$SERVER" 2>/dev/null) || { echo "FAIL no container $SERVER"; exit 1; }
echo "container $SERVER: $state"
[[ $state == running* ]] || ok=0
published=$(docker port "$SERVER" 80/tcp 2>/dev/null)
echo "published: $published"
[[ $published == "127.0.0.1:$PORT" ]] || { echo "FAIL port $PORT is not this container's"; ok=0; }
fi
code=$(curl -s -o /dev/null -w '%{http_code} %{redirect_url}' "$BASE/index.php")
echo "index.php: $code"
[[ $code == 200* || $code == 30[12]* ]] || ok=0
echo "commit: $(git -C "$REPO" rev-parse --short HEAD)"
[ $ok = 1 ] && echo "doctor: ok" || { echo "doctor: FAIL"; exit 1; }
