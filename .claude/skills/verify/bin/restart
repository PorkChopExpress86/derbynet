#!/bin/bash
# Restarts this run's django server on the same database and port, so it
# serves the Python and templates as they are now.  The seed and every change
# made through the browser stay.  PHP needs no restart: its image is rebuilt
# only by launch, and website/ is frozen.
set -euo pipefail
source "$(dirname "$0")/env.sh"
[ "$KIND" = django ] || { echo "restart applies to VERIFY_SERVER=django" >&2; exit 2; }
pid=$(cat "$PIDFILE" 2>/dev/null) || { echo "no $PIDFILE; run bin/launch" >&2; exit 1; }
kill "$pid" 2>/dev/null || true
for _ in $(seq 20); do
  grep -q ":$PORT\b" <<<"$(ss -ltn)" || break
  sleep 0.5
done
start_django
echo ready "$BASE"
